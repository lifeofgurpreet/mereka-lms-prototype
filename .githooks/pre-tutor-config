#!/usr/bin/env bash
# Pre-commit hook for Tutor config changes
# Warns users to use the governed Tutor config wrapper before committing Tutor config
#
# Bypass with: git commit --no-verify (for emergencies only)

set -euo pipefail

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null || true)

if [[ -z "$STAGED_FILES" ]]; then
  exit 0
fi

# Check if tutor_env files are being committed
TUTOR_FILES=()
while IFS= read -r file; do
  if [[ "$file" =~ ^tutor_env/ ]]; then
    TUTOR_FILES+=("$file")
  fi
done <<< "$STAGED_FILES"

# If no tutor_env files, exit
if [[ ${#TUTOR_FILES[@]} -eq 0 ]]; then
  exit 0
fi

echo -e "${YELLOW}=== Tutor Configuration Change Detected ===${NC}"
echo ""
echo "The following Tutor-generated files are being committed:"
echo ""
for file in "${TUTOR_FILES[@]}"; do
  echo "  - $file"
done
echo ""

# Check if config.yml is being committed
CONFIG_CHANGED=false
for file in "${TUTOR_FILES[@]}"; do
  if [[ "$file" == "tutor_env/config.yml" ]]; then
    CONFIG_CHANGED=true
    break
  fi
done

if [[ "$CONFIG_CHANGED" == "true" ]]; then
  echo -e "${YELLOW}WARNING: config.yml is being committed!${NC}"
  echo ""
  echo "This file may contain secrets and is typically gitignored."
  echo "If you're committing it intentionally (e.g., config.example.yml),"
  echo "ensure all secrets are removed first."
  echo ""
fi

# Main warning about governed Tutor render path
echo -e "${YELLOW}IMPORTANT: Did you use tutor-config-save.sh?${NC}"
echo ""
echo "Tutor render output is generated state."
echo "Use the governed wrapper so render, patch-manifest application, and verification stay together."
echo ""
echo "Required path:"
echo "  ${GREEN}./scripts/infra/tutor-config-save.sh --set KEY=value${NC}"
echo "  ${GREEN}./scripts/infra/verify-tutor-config.sh${NC}"
echo ""
echo "The wrapper owns:"
echo "  - repo-scoped TUTOR_ROOT rendering"
echo "  - Tutor plugin mirror refresh"
echo "  - governed patch manifest application"
echo "  - post-render contract verification"
echo ""

# Ask for confirmation
read -rp "Have you run the governed Tutor wrapper and verifier? [y/N] " response

case "$response" in
  [yY][eE][sS]|[yY])
    echo ""
    echo -e "${GREEN}✓ Proceeding with commit${NC}"

    # Optional: run verification script if it exists
    VERIFY_SCRIPT="$(git rev-parse --show-toplevel)/scripts/infra/verify-tutor-config.sh"
    if [[ -x "$VERIFY_SCRIPT" ]]; then
      echo ""
      echo -e "${BLUE}Running verification checks...${NC}"
      if "$VERIFY_SCRIPT"; then
        echo ""
        echo -e "${GREEN}✓ Verification passed${NC}"
        exit 0
      else
        echo ""
        echo -e "${RED}✗ Verification failed${NC}"
        echo ""
        echo "Generated Tutor state did not pass verification."
        echo "Please run:"
        echo "  ./scripts/infra/tutor-config-save.sh --set KEY=value"
        echo "  ./scripts/infra/verify-tutor-config.sh"
        echo ""
        read -rp "Commit anyway? [y/N] " override
        case "$override" in
          [yY][eE][sS]|[yY])
            echo -e "${YELLOW}Committing despite failed verification...${NC}"
            exit 0
            ;;
          *)
            echo -e "${RED}Commit aborted${NC}"
            exit 1
            ;;
        esac
      fi
    fi

    exit 0
    ;;
  *)
    echo ""
    echo -e "${RED}Commit aborted${NC}"
    echo ""
    echo "Please run these commands first:"
    echo ""
    echo "  1. ${GREEN}export TUTOR_ROOT=\"\$(pwd)/tutor_env\"${NC}"
    echo "  2. ${GREEN}./scripts/infra/tutor-config-save.sh --set KEY=value${NC}"
    echo "  3. ${GREEN}./scripts/infra/verify-tutor-config.sh${NC}"
    echo "  4. ${GREEN}tutor local restart${NC}"
    echo ""
    echo "Then try committing again."
    echo ""
    echo "To bypass this check (not recommended):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
    ;;
esac
