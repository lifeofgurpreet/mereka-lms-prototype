#!/usr/bin/env bash
# Pre-commit hook for secret scanning
# Prevents hardcoded secrets from being committed
#
# Bypass with: git commit --no-verify (for emergencies only)

set -euo pipefail

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Track if any secrets were found
SECRETS_FOUND=0
WARNINGS=()

# Get list of staged files (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null || true)

if [[ -z "$STAGED_FILES" ]]; then
  exit 0
fi

# Evidence redaction guardrail (docs evidence paths)
EVIDENCE_REDACTION_CHECK="./scripts/qa/verify-evidence-redaction.sh"
if [[ -x "$EVIDENCE_REDACTION_CHECK" ]] && \
   echo "$STAGED_FILES" | grep -qE '^(docs/operations/evidence/|docs/evidence/observability/)'; then
  echo -e "${GREEN}Checking evidence redaction policy...${NC}"
  if ! STRICT=1 "$EVIDENCE_REDACTION_CHECK" --staged-only; then
    echo ""
    echo -e "${RED}========================================${NC}"
    echo -e "${RED}COMMIT BLOCKED: Evidence redaction check failed${NC}"
    echo -e "${RED}========================================${NC}"
    echo ""
    echo "Redact sensitive headers/tokens in evidence files first."
    echo "Required form: set-cookie: <REDACTED>"
    echo ""
    exit 1
  fi
  echo ""
fi

# Function to check a file for secrets
check_file() {
  local file="$1"
  local line_num=0
  local file_has_secrets=0

  # Skip binary files
  if file "$file" | grep -q "binary"; then
    return 0
  fi

  # Skip certain file types and paths
  case "$file" in
    *.md|*.txt|*.rst|*.html|*.css|*.svg|*.png|*.jpg|*.jpeg|*.gif|*.ico|*.woff|*.woff2|*.ttf|*.eot)
      return 0
      ;;
    *test*|*spec*|*mock*|*fixture*|*__tests__*|*__mocks__*)
      # Skip test files but warn about them
      return 0
      ;;
    *.example|*.sample|*.template)
      return 0
      ;;
    .gitignore|.dockerignore|.editorconfig|.prettierrc*|.eslintrc*|.ruff.toml|pyproject.toml)
      return 0
      ;;
  esac

  while IFS= read -r line || [[ -n "$line" ]]; do
    ((line_num++)) || true

    # Skip empty lines
    [[ -z "$line" ]] && continue

    # Skip comments (various languages)
    if [[ "$line" =~ ^[[:space:]]*# ]] || \
       [[ "$line" =~ ^[[:space:]]*// ]] || \
       [[ "$line" =~ ^[[:space:]]*\* ]] || \
       [[ "$line" =~ ^[[:space:]]*/\* ]]; then
      continue
    fi

    # Skip lines that are clearly environment variable references
    if [[ "$line" =~ os\.environ\.get ]] || \
       [[ "$line" =~ os\.getenv ]] || \
       [[ "$line" =~ \$\{[A-Z_]+\} ]] || \
       [[ "$line" =~ \$[A-Z_]+ ]] || \
       [[ "$line" =~ getenv\( ]] || \
       [[ "$line" =~ process\.env\. ]]; then
      continue
    fi

    # Skip empty values
    if [[ "$line" =~ =[[:space:]]*\"\"[[:space:]]*$ ]] || \
       [[ "$line" =~ =[[:space:]]*\'\'[[:space:]]*$ ]] || \
       [[ "$line" =~ :[[:space:]]*\"\"[[:space:]]*$ ]] || \
       [[ "$line" =~ :[[:space:]]*\'\'[[:space:]]*$ ]] || \
       [[ "$line" =~ =[[:space:]]*None[[:space:]]*$ ]] || \
       [[ "$line" =~ =[[:space:]]*null[[:space:]]*$ ]]; then
      continue
    fi

    # Pattern 1: Hardcoded passwords
    # Matches: PASSWORD = "...", password: "...", passwd = "..."
    if echo "$line" | grep -qiE '(password|passwd|pwd)[[:space:]]*[:=][[:space:]]*["\047][^"\047]+["\047]'; then
      # Exclude placeholder patterns
      if ! echo "$line" | grep -qiE '(CHANGE_ME|changeme|placeholder|example|your_password|xxx+|TODO|FIXME)'; then
        echo -e "${RED}[SECRET]${NC} $file:$line_num - Possible hardcoded password"
        echo "    $line"
        file_has_secrets=1
      fi
    fi

    # Pattern 2: API keys (including camelCase variants)
    # Matches: api_key = "...", apikey: "...", API_KEY = "...", apiKey = "..."
    if echo "$line" | grep -qiE '(api[_-]?[Kk]ey|apikey|API_KEY)[[:space:]]*[:=][[:space:]]*["\047][A-Za-z0-9_\-]{16,}["\047]'; then
      if ! echo "$line" | grep -qiE '(CHANGE_ME|changeme|placeholder|example|xxx+|TODO|FIXME)'; then
        echo -e "${RED}[SECRET]${NC} $file:$line_num - Possible hardcoded API key"
        echo "    $line"
        file_has_secrets=1
      fi
    fi

    # Pattern 2b: HubSpot Personal Access Tokens (pat-na1-...)
    if echo "$line" | grep -qE 'pat-na[0-9]-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'; then
      echo -e "${RED}[SECRET]${NC} $file:$line_num - HubSpot Personal Access Token detected"
      echo "    $line"
      file_has_secrets=1
    fi

    # Pattern 2c: SendGrid API keys (SG....)
    if echo "$line" | grep -qE 'SG\.[A-Za-z0-9_-]{22,}'; then
      if ! echo "$line" | grep -qiE '(example|placeholder|xxx+)'; then
        echo -e "${RED}[SECRET]${NC} $file:$line_num - SendGrid API key detected"
        echo "    $line"
        file_has_secrets=1
      fi
    fi

    # Pattern 3: Secret keys (Django, Flask, etc.)
    # Matches: SECRET_KEY = "...", secret_key: "..."
    if echo "$line" | grep -qiE 'secret[_-]?key[[:space:]]*[:=][[:space:]]*["\047][^"\047]{20,}["\047]'; then
      if ! echo "$line" | grep -qiE '(CHANGE_ME|changeme|placeholder|example|xxx+|TODO|FIXME|insecure)'; then
        echo -e "${RED}[SECRET]${NC} $file:$line_num - Possible hardcoded secret key"
        echo "    $line"
        file_has_secrets=1
      fi
    fi

    # Pattern 4: AWS Access Key ID (starts with AKIA)
    if echo "$line" | grep -qE 'AKIA[A-Z0-9]{16}'; then
      echo -e "${RED}[SECRET]${NC} $file:$line_num - AWS Access Key ID detected"
      echo "    $line"
      file_has_secrets=1
    fi

    # Pattern 5: AWS Secret Access Key
    if echo "$line" | grep -qiE 'aws[_-]?secret[_-]?access[_-]?key[[:space:]]*[:=][[:space:]]*["\047][A-Za-z0-9/+=]{40}["\047]'; then
      echo -e "${RED}[SECRET]${NC} $file:$line_num - AWS Secret Access Key detected"
      echo "    $line"
      file_has_secrets=1
    fi

    # Pattern 6: Private keys
    if echo "$line" | grep -qE '-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----'; then
      echo -e "${RED}[SECRET]${NC} $file:$line_num - Private key detected"
      echo "    $line"
      file_has_secrets=1
    fi

    # Pattern 7: JWT tokens (eyJ... pattern)
    # JWT has 3 base64 parts separated by dots
    if echo "$line" | grep -qE 'eyJ[A-Za-z0-9_-]*\.eyJ[A-Za-z0-9_-]*\.[A-Za-z0-9_-]+'; then
      # Skip if it's in a test file or comment about JWT format
      if ! echo "$line" | grep -qiE '(example|sample|test|mock|format)'; then
        echo -e "${RED}[SECRET]${NC} $file:$line_num - JWT token detected"
        echo "    $line"
        file_has_secrets=1
      fi
    fi

    # Pattern 8: Generic token/auth patterns
    if echo "$line" | grep -qiE '(auth[_-]?token|bearer[_-]?token|access[_-]?token)[[:space:]]*[:=][[:space:]]*["\047][A-Za-z0-9_\-]{20,}["\047]'; then
      if ! echo "$line" | grep -qiE '(CHANGE_ME|changeme|placeholder|example|xxx+|TODO|FIXME)'; then
        echo -e "${RED}[SECRET]${NC} $file:$line_num - Possible hardcoded token"
        echo "    $line"
        file_has_secrets=1
      fi
    fi

    # Pattern 9: Known placeholder patterns that should be removed
    if echo "$line" | grep -qiE '(CHANGE_ME|changeme)[[:space:]]*["\047]?[[:space:]]*$' || \
       echo "$line" | grep -qiE '[:=][[:space:]]*["\047]?(CHANGE_ME|changeme)["\047]?'; then
      echo -e "${YELLOW}[WARNING]${NC} $file:$line_num - Placeholder value found (should be replaced)"
      echo "    $line"
      WARNINGS+=("$file:$line_num - Placeholder value")
    fi

    # Pattern 10: Database connection strings with credentials
    if echo "$line" | grep -qiE '(mysql|postgres|postgresql|mongodb|redis)://[^:]+:[^@]+@'; then
      # Skip if username:password looks like environment variable placeholder
      if ! echo "$line" | grep -qiE '(\$\{|\$[A-Z]|%\(|os\.environ)'; then
        echo -e "${RED}[SECRET]${NC} $file:$line_num - Database connection string with credentials"
        echo "    $line"
        file_has_secrets=1
      fi
    fi

    # Pattern 11: GitHub tokens
    if echo "$line" | grep -qE '(ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9]{22}_[A-Za-z0-9]{59})'; then
      echo -e "${RED}[SECRET]${NC} $file:$line_num - GitHub token detected"
      echo "    $line"
      file_has_secrets=1
    fi

    # Pattern 12: Slack tokens
    if echo "$line" | grep -qE 'xox[baprs]-[A-Za-z0-9\-]+'; then
      echo -e "${RED}[SECRET]${NC} $file:$line_num - Slack token detected"
      echo "    $line"
      file_has_secrets=1
    fi

    # Pattern 13: Google API keys
    if echo "$line" | grep -qE 'AIza[A-Za-z0-9_\-]{35}'; then
      echo -e "${RED}[SECRET]${NC} $file:$line_num - Google API key detected"
      echo "    $line"
      file_has_secrets=1
    fi

  done < "$file"

  return $file_has_secrets
}

echo -e "${GREEN}Scanning staged files for secrets...${NC}"
echo ""

# Check each staged file
for file in $STAGED_FILES; do
  # Skip if file doesn't exist (could be a submodule or symlink)
  [[ -f "$file" ]] || continue

  if ! check_file "$file"; then
    SECRETS_FOUND=1
  fi
done

echo ""

# Report warnings
if [[ ${#WARNINGS[@]} -gt 0 ]]; then
  echo -e "${YELLOW}Warnings (non-blocking):${NC}"
  for warning in "${WARNINGS[@]}"; do
    echo "  - $warning"
  done
  echo ""
fi

# Final verdict
if [[ $SECRETS_FOUND -eq 1 ]]; then
  echo -e "${RED}========================================${NC}"
  echo -e "${RED}COMMIT BLOCKED: Potential secrets found${NC}"
  echo -e "${RED}========================================${NC}"
  echo ""
  echo "Please remove the hardcoded secrets and use environment variables instead."
  echo "See: https://12factor.net/config"
  echo ""
  echo "For this project, use the ExternalSecrets pattern:"
  echo "  1. Add secret to Infisical"
  echo "  2. Sync to GCP Secret Manager"
  echo "  3. Update deploy/k8s/base/secrets/external-secrets.yaml"
  echo "  4. Use os.environ.get('SECRET_NAME') in code"
  echo ""
  echo "If this is a false positive, you can bypass with:"
  echo "  git commit --no-verify"
  echo ""
  echo "But please verify the detection is truly a false positive!"
  exit 1
fi

echo -e "${GREEN}No secrets detected.${NC}"
echo ""

# Check if any Tutor infrastructure files are being committed
TUTOR_FILES=$(echo "$STAGED_FILES" | grep -E "^infrastructure/tutor/|^tutor_env/" || true)

if [[ -n "$TUTOR_FILES" ]]; then
  echo -e "${BLUE}Tutor infrastructure files detected. Running patch verification...${NC}"
  echo ""

  # Run verification script
  REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  VERIFY_SCRIPT="$REPO_ROOT/scripts/infra/verify-tutor-patches.sh"

  if [[ -x "$VERIFY_SCRIPT" ]]; then
    # Run verification (will exit 1 if patches missing)
    if ! "$VERIFY_SCRIPT"; then
      echo ""
      echo -e "${RED}========================================${NC}"
      echo -e "${RED}COMMIT BLOCKED: Tutor patches missing${NC}"
      echo -e "${RED}========================================${NC}"
      echo ""
      echo "Some required Tutor patches are not applied."
      echo "This usually happens after running 'tutor config save' without applying patches."
      echo ""
      echo "To fix:"
      echo "  ./infrastructure/tutor/apply-patches.sh"
      echo ""
      echo "Or bypass with: git commit --no-verify (not recommended)"
      echo ""
      exit 1
    fi
    echo -e "${GREEN}✓ Tutor patches verified${NC}"
  else
    echo -e "${YELLOW}⚠ Verification script not found or not executable${NC}"
    echo "Skipping Tutor patch verification."
  fi
  echo ""
fi

# ========================================
# Spec & Testmap Linting (Non-blocking)
# ========================================

echo -e "${GREEN}Running spec lint checks...${NC}"
echo ""

SPEC_WARNINGS=0

# Check if python3 is available
if ! command -v python3 &> /dev/null; then
  echo -e "${YELLOW}[WARNING]${NC} python3 not found, skipping spec lint checks"
  echo ""
else
  # Check for spec files
  SPEC_FILES=$(echo "$STAGED_FILES" | grep -E "^specs/.*\.md$" || true)

  if [[ -n "$SPEC_FILES" ]]; then
    echo -e "${YELLOW}Spec files detected, running lint...${NC}"

    if [[ -f "scripts/qa/spec-tools/mereka_spec_lint.py" ]]; then
      if python3 scripts/qa/spec-tools/mereka_spec_lint.py specs/ --severity-filter error 2>&1 | tee /tmp/spec-lint.out; then
        echo -e "${GREEN}✓ Spec lint passed${NC}"
      else
        echo -e "${YELLOW}⚠ Spec lint found issues (non-blocking)${NC}"
        cat /tmp/spec-lint.out
        SPEC_WARNINGS=1
      fi
    else
      echo -e "${YELLOW}⚠ mereka_spec_lint.py not found, skipping${NC}"
    fi
    echo ""
  fi

  # Check for testmap files
  TESTMAP_FILES=$(echo "$STAGED_FILES" | grep -E "^specs/testmaps/.*\.ya?ml$" || true)

  if [[ -n "$TESTMAP_FILES" ]]; then
    echo -e "${YELLOW}Testmap files detected, running validation...${NC}"

    if [[ -f "scripts/qa/spec-tools/validate_testmap_format.py" ]]; then
      if python3 scripts/qa/spec-tools/validate_testmap_format.py specs/testmaps/ 2>&1 | tee /tmp/testmap-validation.out; then
        echo -e "${GREEN}✓ Testmap validation passed${NC}"
      else
        echo -e "${YELLOW}⚠ Testmap validation found issues (non-blocking)${NC}"
        cat /tmp/testmap-validation.out
        SPEC_WARNINGS=1
      fi
    else
      echo -e "${YELLOW}⚠ validate_testmap_format.py not found, skipping${NC}"
    fi
    echo ""
  fi

  # Check for K8s manifests
  K8S_FILES=$(echo "$STAGED_FILES" | grep -E "^deploy/k8s/.*\.ya?ml$" || true)

  if [[ -n "$K8S_FILES" ]]; then
    echo -e "${YELLOW}K8s manifest files detected, checking labels...${NC}"

    K8S_LABEL_WARNINGS=0
    for file in $K8S_FILES; do
      # Skip if file doesn't exist or is deleted
      [[ -f "$file" ]] || continue

      # Check for app.kubernetes.io/name label
      if ! grep -q "app.kubernetes.io/name" "$file"; then
        echo -e "${YELLOW}[WARNING]${NC} $file - Missing recommended label 'app.kubernetes.io/name'"
        K8S_LABEL_WARNINGS=1
      fi
    done

    if [[ $K8S_LABEL_WARNINGS -eq 0 ]]; then
      echo -e "${GREEN}✓ K8s label checks passed${NC}"
    else
      echo -e "${YELLOW}⚠ Some K8s manifests missing recommended labels (non-blocking)${NC}"
      SPEC_WARNINGS=1
    fi
    echo ""
  fi
fi

# Summary
if [[ $SPEC_WARNINGS -eq 1 ]]; then
  echo -e "${YELLOW}========================================${NC}"
  echo -e "${YELLOW}Spec/Testmap warnings detected${NC}"
  echo -e "${YELLOW}========================================${NC}"
  echo ""
  echo "These warnings are non-blocking, but please review them."
  echo "Consider fixing issues before committing for better quality."
  echo ""
fi

echo -e "${GREEN}All checks passed. Proceeding with commit.${NC}"
exit 0
