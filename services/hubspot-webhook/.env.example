# HubSpot Configuration
HUBSPOT_PAT=your-hubspot-private-access-token
HUBSPOT_WEBHOOK_SECRET=your-hubspot-webhook-secret
HUBSPOT_REGISTRATION_ENABLED=false

# Microsoft Community Training (MCT) Configuration
MCT_ENDPT=your-mct-endpoint.example.com
MCT_CLIENT_ID=your-mct-client-id
MCT_CLIENT_SECRET=your-mct-client-secret
MCT_API_URI=api://your-mct-api-uri
MCT_TENANT_ID=your-azure-tenant-id

# Azure AD B2C Configuration
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# SendGrid Configuration
SGRID_API_KEY=your-sendgrid-api-key
SGRID_FROM_EMAIL=team@example.com

# Error Notifications (comma-separated emails)
ERROR_NOTIFICATION_EMAILS=admin1@example.com,admin2@example.com
