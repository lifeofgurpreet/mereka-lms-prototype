{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "schema_version",
    "generated_by",
    "source_range",
    "canonical_inputs",
    "release_status",
    "dependent_receipts",
    "affected_repos",
    "affected_contracts",
    "unresolved_inputs",
    "explanation"
  ],
  "properties": {
    "receipt_id": { "const": "release-decision-receipt" },
    "schema_version": { "type": "integer", "const": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "source_range": { "type": "string", "minLength": 1 },
    "canonical_inputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "release_status": { "type": "string", "minLength": 1 },
    "dependent_receipts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "affected_repos": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "affected_contracts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unresolved_inputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "explanation": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  }
}
