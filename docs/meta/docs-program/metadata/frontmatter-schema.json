{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mereka.io/docs/frontmatter-schema.json",
  "title": "Canonical Docs Frontmatter Schema",
  "type": "object",
  "required": [
    "title",
    "owner",
    "status",
    "last_reviewed",
    "canonical_root",
    "doc_class",
    "summary",
    "tags"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "canonical",
        "supporting",
        "generated",
        "superseded"
      ]
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "canonical_root": {
      "type": "string",
      "enum": [
        "docs/concepts/architecture",
        "docs/architecture",
        "docs/ops",
        "docs/guides",
        "docs/reference",
        "docs/policies",
        "docs/meta",
        "docs/adr",
        "docs/evidence",
        "docs/status"
      ]
    },
    "doc_class": {
      "type": "string",
      "enum": [
        "architecture-standard",
        "adr",
        "rfc",
        "ops-runbook",
        "guide",
        "reference",
        "policy",
        "evidence",
        "status"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "governs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_cycle": {
      "type": "string"
    },
    "adr_id": {
      "type": "string",
      "pattern": "^ADR-\\d{3}$"
    },
    "decision_status": {
      "type": "string"
    },
    "decision_type": {
      "type": "string"
    },
    "rollout_state": {
      "type": "string"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    },
    "exception_expiry": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "proposal_state": {
      "type": "string"
    },
    "service_area": {
      "type": "string"
    },
    "verification_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audience": {
      "type": "string"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reference_scope": {
      "type": "string"
    },
    "source_of_truth": {
      "type": "string"
    },
    "policy_scope": {
      "type": "string"
    },
    "enforced_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim": {
      "type": "string"
    },
    "evidence_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_status": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status_scope": {
      "type": "string"
    },
    "status_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "doc_class": {
            "const": "architecture-standard"
          }
        }
      },
      "then": {
        "required": [
          "governs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "doc_class": {
            "const": "adr"
          }
        }
      },
      "then": {
        "required": [
          "adr_id",
          "decision_status",
          "decision_type",
          "governs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "doc_class": {
            "const": "rfc"
          }
        }
      },
      "then": {
        "required": [
          "adr_id",
          "proposal_state",
          "governs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "doc_class": {
            "const": "evidence"
          }
        }
      },
      "then": {
        "required": [
          "claim",
          "evidence_date"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "doc_class": {
            "const": "status"
          }
        }
      },
      "then": {
        "required": [
          "status_scope",
          "status_date"
        ]
      }
    }
  ],
  "additionalProperties": true
}
