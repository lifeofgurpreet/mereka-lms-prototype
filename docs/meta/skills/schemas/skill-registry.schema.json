{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wave11/skill-registry",
  "type": "object",
  "required": ["pack_id", "schema_version", "generated_by", "source_range", "canonical_inputs", "runtime_model", "taxonomy", "skills"],
  "properties": {
    "pack_id": { "const": "skill-registry" },
    "schema_version": { "type": "integer", "const": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "source_range": { "type": ["string", "null"] },
    "canonical_inputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "runtime_model": { "type": "string", "minLength": 1 },
    "taxonomy": { "type": "string", "minLength": 1 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "skill_id", "title", "purpose", "scope", "category",
          "authoritative_sources", "generated_dependencies",
          "primary_repo", "secondary_repos", "allowed_commands",
          "forbidden_or_destructive_commands", "canonical_entrypoints",
          "required_reviewers", "required_evidence_classes",
          "pack_dependencies", "command_dependencies", "reviewer_rules",
          "evidence_rules", "escalation_rules", "applies_to_repos",
          "stable_inputs",
          "escalation_triggers", "preconditions", "expected_outputs",
          "failure_modes", "read_first_paths",
          "historical_or_archive_dependencies", "stability_level"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "skill_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "primary_repo": { "type": "string", "minLength": 1 },
          "secondary_repos": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "generated_dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "pack_dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "command_dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "applies_to_repos": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "stable_inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["repo", "path"],
              "properties": {
                "repo": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 }
              }
            }
          },
          "forbidden_or_destructive_commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "required_reviewers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "required_evidence_classes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "reviewer_rules": {
            "type": "object",
            "required": ["required_reviewers", "merge_strategy"],
            "properties": {
              "required_reviewers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "merge_strategy": { "type": "string", "minLength": 1 }
            }
          },
          "evidence_rules": {
            "type": "object",
            "required": ["required_evidence_classes", "sufficiency_policy"],
            "properties": {
              "required_evidence_classes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "sufficiency_policy": { "type": "string", "minLength": 1 }
            }
          },
          "escalation_rules": {
            "type": "object",
            "required": ["triggers", "manual_review_required"],
            "properties": {
              "triggers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "manual_review_required": { "type": "boolean" }
            }
          },
          "escalation_triggers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "expected_outputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "failure_modes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "historical_or_archive_dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "stability_level": { "type": "string", "enum": ["stable", "evolving", "experimental"] },
          "authoritative_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["repo", "path"],
              "properties": {
                "repo": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 }
              }
            }
          },
          "allowed_commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["repo", "command"],
              "properties": {
                "repo": { "type": "string", "minLength": 1 },
                "command": { "type": "string", "minLength": 1 }
              }
            }
          },
          "canonical_entrypoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["repo", "command"],
              "properties": {
                "repo": { "type": "string", "minLength": 1 },
                "command": { "type": "string", "minLength": 1 }
              }
            }
          },
          "read_first_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["repo", "path"],
              "properties": {
                "repo": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
