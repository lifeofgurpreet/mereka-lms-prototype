{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wave11/read-first",
  "type": "object",
  "required": ["pack_id", "schema_version", "generated_by", "source_range", "canonical_inputs", "entries", "do_not_trust_first"],
  "properties": {
    "pack_id": { "const": "read-first" },
    "schema_version": { "type": "integer", "const": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "source_range": { "type": ["string", "null"] },
    "canonical_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["repo", "path"],
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "do_not_trust_first": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
