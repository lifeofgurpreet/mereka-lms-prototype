{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wave11/evidence-sufficiency-map",
  "type": "object",
  "required": ["pack_id", "schema_version", "generated_by", "source_range", "canonical_inputs", "evidence_classes"],
  "properties": {
    "pack_id": { "const": "evidence-sufficiency-map" },
    "schema_version": { "type": "integer", "const": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "source_range": { "type": ["string", "null"] },
    "canonical_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_class", "required_for_skills", "required_reviewers", "sufficiency_policy", "escalation_if_missing"],
        "properties": {
          "evidence_class": { "type": "string", "minLength": 1 },
          "required_for_skills": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "required_reviewers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "sufficiency_policy": { "type": "string", "minLength": 1 },
          "escalation_if_missing": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
