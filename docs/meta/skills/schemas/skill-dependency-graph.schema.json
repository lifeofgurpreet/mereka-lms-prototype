{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wave11/skill-dependency-graph",
  "type": "object",
  "required": ["pack_id", "schema_version", "generated_by", "source_range", "canonical_inputs", "nodes", "edges"],
  "properties": {
    "pack_id": { "const": "skill-dependency-graph" },
    "schema_version": { "type": "integer", "const": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "source_range": { "type": ["string", "null"] },
    "canonical_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
