{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wave11/scenario-packs",
  "type": "object",
  "required": ["pack_id", "schema_version", "generated_by", "source_range", "canonical_inputs", "scenarios"],
  "properties": {
    "pack_id": { "const": "scenario-packs" },
    "schema_version": { "type": "integer", "const": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "source_range": { "type": ["string", "null"] },
    "canonical_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scenario_id", "title", "goal", "applicable_repos", "read_first",
          "required_skills", "commands_to_run", "evidence_to_collect",
          "escalation_points", "stop_conditions", "expected_outputs",
          "reviewer_signoff_rules"
        ],
        "properties": {
          "scenario_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "applicable_repos": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "required_skills": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "evidence_to_collect": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "escalation_points": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "stop_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "expected_outputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "reviewer_signoff_rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "read_first": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["repo", "path"],
              "properties": {
                "repo": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 }
              }
            }
          },
          "commands_to_run": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["command_id", "repo", "command"],
              "properties": {
                "command_id": { "type": "string", "minLength": 1 },
                "repo": { "type": "string", "minLength": 1 },
                "command": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
