{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wave11/mixed-diff-arbitration",
  "type": "object",
  "required": ["pack_id", "schema_version", "generated_by", "source_range", "canonical_inputs", "rules"],
  "properties": {
    "pack_id": { "const": "mixed-diff-arbitration" },
    "schema_version": { "type": "integer", "const": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "source_range": { "type": ["string", "null"] },
    "canonical_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "when_categories", "reviewer_merge_strategy", "evidence_merge_strategy", "primary_read_first_skill", "manual_arbitration_trigger"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "when_categories": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
          "reviewer_merge_strategy": { "type": "string", "minLength": 1 },
          "evidence_merge_strategy": { "type": "string", "minLength": 1 },
          "primary_read_first_skill": { "type": "string", "minLength": 1 },
          "manual_arbitration_trigger": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
