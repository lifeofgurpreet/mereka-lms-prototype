  "required_configmaps": [
    "caddy-config",
    "openedx-settings-lms",
    "openedx-settings-cms",
    "openedx-config",
    "openedx-uwsgi-config",
    "openedx-theme-head-extra",
    "redis-config",
    "discovery-settings",
    "credentials-settings",
    "mfe-caddy-config",
    "notes-settings",
    "xqueue-settings",
    "enterprise-access-settings"
  ],
  "_required_configmaps_note": "ConfigMaps generated by sub-kustomizations (e.g. mux-delivery-monitor-script in monitoring/) are not listed here — they are verified by the sub-kustomization's own tests.",

  "cluster_secret_store": {
    "default": "gcp-secret-manager",
    "_note": "Overlays may patch to infisical-secret-store or other backends"
  },

  "images": {
    "openedx": {
      "default_registry": "ghcr.io/biji-biji-initiative/mereka-lms/openedx",
      "default_tag": "pin-required",
      "_note": "Sentinel tag — does not exist. Every overlay MUST override with a real pinned tag."
    },
    "mfe": {
      "default_registry": "ghcr.io/biji-biji-initiative/mereka-lms/mfe",
      "default_tag": "pin-required",
      "_note": "Sentinel tag — does not exist. Every overlay MUST override with a real pinned tag."
    }
  },

  "jobs": [
    "jobs/discovery-sync-cronjob.yaml"
  ],
  "_jobs_note": "Only recurring CronJobs are listed here and included in the kustomize render graph. One-shot migration Jobs (lms-migrate, cms-migrate, enterprise-catalog-migrate, enterprise-access-migrate, enterprise-subsidy-migrate, license-manager-migrate) live in deploy/k8s/base/jobs/ but are applied manually during releases. See deploy/k8s/base/jobs/README.md.",

  "migrations": {
    "registry": "migrations/registry.yaml",
    "services": [
      {
        "name": "lms",
        "database": "mysql",
        "migration_command": "python manage.py lms migrate --noinput",
        "health_endpoint": "/heartbeat",
        "health_port": 8000,
        "release_critical": true
      },
      {
        "name": "cms",
        "database": "mysql",
        "migration_command": "python manage.py cms migrate --noinput",
        "health_endpoint": "/heartbeat",
        "health_port": 8000,
        "release_critical": true
      },
      {
        "name": "discovery",
        "database": "mysql",
        "migration_command": "python manage.py migrate --noinput",
        "health_endpoint": "/health/",
        "health_port": 8000,
        "release_critical": true
      },
      {
        "name": "credentials",
        "database": "mysql",
        "migration_command": "python manage.py migrate --noinput",
        "health_endpoint": "/health/",
        "health_port": 8000,
        "release_critical": false
      },
      {
        "name": "notes",
        "database": "mysql",
        "migration_command": "python manage.py migrate --noinput",
        "health_endpoint": "/heartbeat",
        "health_port": 8000,
        "release_critical": false
      },
      {
        "name": "xqueue",
        "database": "mysql",
        "migration_command": "python manage.py migrate --noinput",
        "health_endpoint": "/status/",
        "health_port": 8000,
        "release_critical": false,
        "disabled": true
      },
      {
        "name": "enterprise-catalog",
        "database": "mysql",
        "migration_command": "python manage.py migrate --noinput",
        "health_endpoint": "/health/",
        "health_port": 8160,
        "release_critical": false
      },
      {
        "name": "enterprise-access",
        "database": "mysql",
        "migration_command": "python manage.py migrate --noinput",
        "health_endpoint": "/health/",
        "health_port": 18270,
        "release_critical": false
      },
      {
        "name": "enterprise-subsidy",
        "database": "mysql",
        "migration_command": "python manage.py migrate --noinput",
        "health_endpoint": "/health/",
        "health_port": 18280,
        "release_critical": false
      },
      {
        "name": "license-manager",
        "database": "mysql",
        "migration_command": "python manage.py migrate --noinput",
        "health_endpoint": "/health/",
        "health_port": 18170,
        "release_critical": false
      },
      {
        "name": "payments-gateway",
        "database": "postgresql",
        "migration_command": "python -m alembic upgrade head",
        "health_endpoint": "/health/",
        "health_port": 8080,
        "release_critical": true
      }
    ]
  },

  "allowedGitOpsOverrides": [
    {
      "type": "namespace",
      "description": "Set namespace for entire app",
      "example": "namespace: mereka-lms-dev"
    },
    {
      "type": "image_pin",
      "description": "Override image tag/digest per environment",
      "example": "newTag: sha-abc123"
    },
    {
      "type": "ingress_host",
      "description": "Domain names per environment",
      "example": "host: academyv2.mereka.io"
    },
    {
      "type": "tls_certificate",
      "description": "TLS cert and issuer per environment"
    },
    {
      "type": "secret_store_ref",
      "description": "ClusterSecretStore backend per cluster",
      "example": "name: infisical-secret-store-dev"
    },
    {
      "type": "env_var_injection",
      "description": "Environment-specific values via env vars",
      "allowed_vars": [
        "LMS_ROOT_URL", "CMS_ROOT_URL", "MFE_HOST",
        "MYSQL_HOST", "REDIS_HOST", "MONGODB_HOST",
        "SENTRY_DSN", "SENTRY_ENVIRONMENT",
        "ENABLE_GATEWAY_FULFILLMENT",
        "MEREKA_LMS_DOMAIN", "MEREKA_CREDENTIALS_DOMAIN"
      ]
    },
    {
      "type": "resource_sizing",
      "description": "CPU/memory requests and limits per environment"
    },
    {
      "type": "replica_count",
      "description": "Scale per environment capacity"
    },
    {
      "type": "argocd_application",
      "description": "ArgoCD Application/ApplicationSet definitions"
    },
    {
      "type": "sync_policy",
      "description": "ArgoCD sync policy and health checks"
    },
    {
      "type": "storage_class",
      "description": "PVC storageClassName per cluster"
    }
  ],

  "forbiddenGitOpsMutations": [
    {
      "type": "python_settings_logic",
      "description": "Django production.py variants or FEATURES/INSTALLED_APPS in overlay YAML",
      "fix": "Add env var read in production.py, set env var in overlay"
    },
    {
      "type": "configmap_hash_hardcoding",
      "description": "Hardcoded Kustomize content-hash names (e.g. openedx-settings-lms-45kb8hh58m)",
      "fix": "Use patchesStrategicMerge with name-based matching"
    },
    {
      "type": "full_caddyfile_override",
      "description": "Replacing entire Caddyfile with app routing logic",
      "fix": "App repo owns Caddyfile, overlay patches only hosts/TLS"
    },
    {
      "type": "mutable_base_image_tag",
      "description": ":latest, :main, or branch tags in production overlay",
      "fix": "Always use SHA-pinned tags from build pipeline"
    },
    {
      "type": "cluster_scoped_resource",
      "description": "ClusterPolicy, ClusterRole, ClusterSecretStore in app overlay",
      "fix": "Cluster-scoped resources go in platform-control-plane repo"
    },
    {
      "type": "positional_array_patch",
      "description": "JSON6902 patches using array indices (e.g. /spec/template/spec/volumes/0)",
      "fix": "Use strategic merge or named patch targets"
    },
    {
      "type": "app_middleware_sequencing",
      "description": "Django middleware or auth configuration in overlay",
      "fix": "Middleware config belongs in app repo production.py"
    }
  ],

  "stableResourceNames": {
    "configMaps": [
      "caddy-config", "openedx-settings-lms", "openedx-settings-cms",
      "openedx-config", "openedx-uwsgi-config", "openedx-theme-head-extra",
      "redis-config", "discovery-settings", "credentials-settings",
      "mfe-caddy-config", "notes-settings", "xqueue-settings",
      "enterprise-access-settings"
    ],
    "secrets": [
      "openedx-secrets", "database-secrets", "enterprise-secrets",
      "enterprise-sso-secrets", "aspects-secrets", "payments-gateway-secrets",
      "ses-smtp-credentials"
    ],
    "labels": {
      "instance": "app.kubernetes.io/instance: mereka-lms",
      "partOf": "app.kubernetes.io/part-of: mereka-lms",
      "name": "app.kubernetes.io/name: <workload-name>"
    },
    "_note": "Overlays must reference these names. Kustomize content-hashes ConfigMap names — NEVER hardcode the hashed suffix."
  }
}
