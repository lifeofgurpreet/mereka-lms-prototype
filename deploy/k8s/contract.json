        "MONGODB_USERNAME", "MONGODB_PASSWORD",
        "FORUM_MONGODB_HOST", "FORUM_MONGODB_PASSWORD",
        "MEILISEARCH_MASTER_KEY", "MEILISEARCH_API_KEY",
        "JWT_SECRET_KEY_LMS", "JWT_SECRET_KEY_CMS",
        "JWT_SECRET_KEY_DISCOVERY", "JWT_SECRET_KEY_NOTES",
        "JWT_SECRET_KEY_XQUEUE", "JWT_PRIVATE_SIGNING_JWK",
        "EDX_API_KEY",
        "DISCOVERY_SECRET_KEY", "DISCOVERY_SOCIAL_AUTH_EDX_OAUTH2_SECRET",
        "DISCOVERY_BACKEND_OAUTH2_SECRET",
        "NOTES_SECRET_KEY", "NOTES_CLIENT_SECRET",
        "XQUEUE_SECRET_KEY", "XQUEUE_LMS_PASSWORD",
        "CMS_SOCIAL_AUTH_EDX_OAUTH2_SECRET", "OIDC_CLIENT_SECRET",
        "CREDENTIALS_SECRET_KEY", "CREDENTIALS_BACKEND_OAUTH2_SECRET",
        "CREDENTIALS_SSO_OAUTH2_SECRET", "JWT_SECRET_KEY_CREDENTIALS",
        "STRIPE_SECRET_KEY", "STRIPE_PUBLISHABLE_KEY", "STRIPE_WEBHOOK_SECRET",
        "SENTRY_DSN", "SENTRY_ENVIRONMENT",
