# Global configuration
{



}

# proxy directive snippet (with logging) to be used as follows:
#
#     import proxy "containername:port"
(proxy) {
    log {
        output stdout
        format filter {
            wrap json
            fields {
                common_log delete
                request>headers delete
                resp_headers delete
                tls delete
            }
        }
    }

    # This will compress requests that matches the default criteria set by Caddy.
    # see https://caddyserver.com/docs/caddyfile/directives/encode
    # for information about the defaults; i.e. how/when this will be applied.
    encode gzip

    reverse_proxy {args.0} {
        header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
        header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
    }


}

# LMS - local development (HTTP only)
localhost{$default_site_port}, preview.localhost{$default_site_port} {
    @favicon_matcher {
        path_regexp ^/favicon.ico$
    }
    rewrite @favicon_matcher /theming/asset/images/favicon.ico

    # Limit profile image upload size
    handle_path /api/profile_images/*/*/upload {
        request_body {
            max_size 1MB
        }
    }

    import proxy "lms:8000"

    handle_path /* {
        request_body {
            max_size 4MB
        }
    }
}

# LMS - production/dev + microsites (TLS via Caddy)
# - academyv2.mereka.io: main GKE environment (PRODUCTION DOMAIN)
# - academyv2.mereka.dev: VPS kind cluster
# - skillourfuture.academy.mereka.io: Skill Our Future microsite
# - academy.biji-biji.com: Biji-Biji Academy microsite
academyv2.mereka.io, academyv2.mereka.dev, preview.academyv2.mereka.io, preview.academyv2.mereka.dev, skillourfuture.academy.mereka.io, academy.biji-biji.com {
    @favicon_matcher {
        path_regexp ^/favicon.ico$
    }
    rewrite @favicon_matcher /theming/asset/images/favicon.ico

    # Limit profile image upload size
    handle_path /api/profile_images/*/*/upload {
        request_body {
            max_size 1MB
        }
    }

    import proxy "lms:8000"



    handle_path /* {
        request_body {
            max_size 4MB
        }
    }
}

# Studio/CMS - local development (HTTP only)
studio.localhost{$default_site_port} {
    @favicon_matcher {
        path_regexp ^/favicon.ico$
    }
    rewrite @favicon_matcher /theming/asset/images/favicon.ico

    import proxy "cms:8000"



    handle_path /* {
        request_body {
            max_size 250MB
        }
    }
}

# Studio/CMS - production/dev (TLS via Caddy)
# - studio.academyv2.mereka.io: GKE Studio
# - studio.academyv2.mereka.dev: VPS kind Studio
# - studio.academy.biji-biji.com: Biji-Biji Studio
studio.academyv2.mereka.io, studio.academyv2.mereka.dev, studio.academy.biji-biji.com {
    @favicon_matcher {
        path_regexp ^/favicon.ico$
    }
    rewrite @favicon_matcher /theming/asset/images/favicon.ico

    import proxy "cms:8000"

    handle_path /* {
        request_body {
            max_size 250MB
        }
    }
}

