# Global configuration
{
    auto_https off
    admin 0.0.0.0:2019
}

# proxy directive snippet (with logging) to be used as follows:
#
#     import proxy "containername:port"
(proxy) {
    log {
        output stdout
        format filter {
            wrap json
            fields {
                common_log delete
                request>headers delete
                resp_headers delete
                tls delete
            }
        }
    }

    # This will compress requests that matches the default criteria set by Caddy.
    # see https://caddyserver.com/docs/caddyfile/directives/encode
    # for information about the defaults; i.e. how/when this will be applied.
    encode gzip

    reverse_proxy {args[0]} {
        header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
        header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
        header_up X-Request-ID {http.request.header.X-Request-ID}
        header_up traceparent {http.request.header.traceparent}
    }

    # Default: require revalidation on every request. This covers HTML pages and
    # API responses while still allowing conditional 304s via ETag/Last-Modified.
    header Cache-Control "no-cache"

    # Hashed static assets (Django ManifestStaticFilesStorage): safe to cache long-term.
    @static_hashed {
        path /static/* /theming/asset/*
    }
    header @static_hashed Cache-Control "public, max-age=31536000, immutable"

    # Media uploads (profile images, course assets): cache with short revalidation.
    @media_assets {
        path /media/*
    }
    header @media_assets Cache-Control "public, max-age=3600"

    # Sensitive API endpoints: never cache.
    @api_no_store {
        path /api/* /oauth2/* /login* /logout* /admin/*
    }
    header @api_no_store Cache-Control "no-store"

}

# LMS - local development (HTTP only)
localhost{$default_site_port}, preview.localhost{$default_site_port} {
    @favicon_matcher {
        path_regexp ^/favicon.ico$
    }
    rewrite @favicon_matcher /theming/asset/images/favicon.ico

    # Limit profile image upload size
    handle_path /api/profile_images/*/*/upload {
        request_body {
            max_size 1MB
        }
    }

    import proxy "lms:8000"

    handle_path /* {
        request_body {
            max_size 4MB
        }
    }
}

# LMS - environment-specific domains (TLS via NGINX Ingress)
# Domains are injected via environment variables; overlays must set:
#   LMS_HOST        — primary LMS hostname (e.g. academyv2.mereka.io)
#   LMS_HOST_PREVIEW — preview hostname    (e.g. preview.academyv2.mereka.io)
# Additional microsite domains are added by overlay-supplied Caddyfile overrides.
http://{$LMS_HOST}, http://{$LMS_HOST_PREVIEW} {
    @favicon_matcher {
        path_regexp ^/favicon.ico$
    }
    rewrite @favicon_matcher /theming/asset/images/favicon.ico

    # Limit profile image upload size
    handle_path /api/profile_images/*/*/upload {
        request_body {
            max_size 1MB
        }
    }

    # Purchase Gateway — Stripe webhooks + checkout API
    handle /payments/* {
        uri strip_prefix /payments
        reverse_proxy payments-gateway:8080 {
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up traceparent {http.request.header.traceparent}
        }
    }

    import proxy "lms:8000"



    handle_path /* {
        request_body {
            max_size 4MB
        }
    }
}

