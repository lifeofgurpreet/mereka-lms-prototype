    }
}

# Discovery Service (Course Catalog API)
discovery.localhost{$default_site_port} {
    request_body {
        max_size 10MB
    }

    import proxy "discovery:8000"
}

# Discovery Service (TLS via NGINX Ingress)
http://discovery.academyv2.mereka.io, http://discovery.academyv2.mereka.dev {
    request_body {
        max_size 10MB
    }

    import proxy "discovery:8000"
}
