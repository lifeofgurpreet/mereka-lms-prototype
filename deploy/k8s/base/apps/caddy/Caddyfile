# Credentials Service
http://credentials.academyv2.mereka.io, http://credentials.academyv2.mereka.dev {
    # Authn assets are served by MFE; keep service-domain admin/login pages branded/functional.
    handle /authn/* {
        reverse_proxy mfe:8002 {
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up traceparent {http.request.header.traceparent}
        }
    }

    # Keep service-domain admin login route aligned to the shared authn shell.
    handle /admin/login {
        rewrite * /authn/login
        reverse_proxy mfe:8002 {
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up traceparent {http.request.header.traceparent}
        }
    }
    handle /admin/login/* {
        rewrite * /authn/login
        reverse_proxy mfe:8002 {
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up traceparent {http.request.header.traceparent}
        }
    }

    @credentials_root path /
    header @credentials_root Content-Type "text/html; charset=utf-8"
    respond @credentials_root "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Mereka Credentials</title></head><body style='margin:0;padding:40px;background:#f5f7fb;color:#1a1623;font-family:Poppins,Lato,sans-serif'><main style='max-width:760px;margin:0 auto;background:#fff;padding:32px;border-radius:20px;border:1px solid rgba(26,22,35,.08);box-shadow:0 16px 50px rgba(26,22,35,.1)'><h1 style='margin:0 0 12px;color:#2d898b;font-size:2rem;line-height:1.2'>Mereka Credentials Service</h1><p style='margin:0 0 16px;font-size:1rem;line-height:1.6'>Credential issuance APIs are online. Use the admin route for operator actions and the health route for service checks.</p><p style='margin:0'><a href='/admin/login/' style='color:#295cad;font-weight:600;text-decoration:none'>Open admin login</a><span style='opacity:.5'> · </span><a href='/health/' style='color:#295cad;font-weight:600;text-decoration:none'>Health endpoint</a></p></main></body></html>" 200
    import proxy "credentials:8000"
}

# Forum v2 (Python) is now integrated into LMS - no standalone forum service.
# Discussion APIs are served by the LMS at /api/discussion/ and /forum_form_discussion/.
# The Discussions MFE handles the learner-facing UI.

# Enterprise Admin Portal MFE (TLS via NGINX Ingress)
http://admin.academyv2.mereka.io {
    request_body {
        max_size 2MB
    }
        reverse_proxy /api/mfe_config/v1* lms:8000 {
            header_up Host {http.request.host}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up traceparent {http.request.header.traceparent}
        }
        reverse_proxy /login_refresh* lms:8000 {
            header_up Host {http.request.host}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up traceparent {http.request.header.traceparent}
        }
    # Enterprise service APIs — routed to internal K8s services via path prefix.
    # Same-origin (admin subdomain) so no CORS complications.
    handle /api/enterprise-catalog/* {
        uri strip_prefix /api/enterprise-catalog
        reverse_proxy enterprise-catalog:8160 {
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up traceparent {http.request.header.traceparent}
        }
    }
    handle /api/enterprise-access/* {
        uri strip_prefix /api/enterprise-access
        reverse_proxy enterprise-access:18270 {
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up traceparent {http.request.header.traceparent}
        }
    }
    handle /api/license-manager/* {
        uri strip_prefix /api/license-manager
        reverse_proxy license-manager:18170 {
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up traceparent {http.request.header.traceparent}
        }
    }
    handle /api/enterprise-subsidy/* {
        uri strip_prefix /api/enterprise-subsidy
        reverse_proxy enterprise-subsidy:18280 {
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up traceparent {http.request.header.traceparent}
        }
    }
    import proxy "enterprise-admin-portal:8002"
}

