# MFE (Micro-Frontends) - localhost and production/dev
# - apps.localhost: local development
# - apps.academyv2.mereka.io: main GKE MFEs
# - apps.academyv2.mereka.dev: VPS kind MFEs
# - apps.academy.biji-biji.com: Biji-Biji Academy MFEs
apps.localhost{$default_site_port} {
    request_body {
        max_size 2MB
    }
    import proxy "mfe:8002"
}

# MFE (TLS via NGINX Ingress)
http://apps.academyv2.mereka.io, http://apps.academyv2.mereka.dev, http://apps.academy.biji-biji.com {
    redir / https://academyv2.mereka.io
    request_body {
        max_size 2MB
    }
    import proxy "mfe:8002"
}
