# MFE (Micro-Frontends) - localhost and production/dev
# - apps.localhost: local development
# MFE_HOST is injected by the overlay (e.g. apps.academyv2.mereka.io).
apps.localhost{$default_site_port} {
    request_body {
        max_size 2MB
    }
    import proxy "mfe:8002"
}

# MFE (TLS via NGINX Ingress)
http://{$MFE_HOST} {
    # Root apps host contract: stay on the tenant apps host and land on the authn shell.
    # Without this, requests to apps.<tenant>/ fall through and leak to the shared LMS host.
    @mfe_root_entry {
        path /
    }
    redir @mfe_root_entry /authn/login?next=%2Fdashboard 302

    # Learner-home alias: human entry traffic expects /dashboard on the apps host,
    # but the shipped learner-home MFE lives at /learner-dashboard/.
    @mfe_dashboard_alias {
        path /dashboard /dashboard/
    }
    redir @mfe_dashboard_alias /learner-dashboard/ 302

    # Account MFE requires trailing slash: React Router basename=/account/ won't
    # match /account (no slash), rendering a blank page. Redirect silently.
    @account_no_slash {
        path /account
    }
    redir @account_no_slash /account/ 302

    request_body {
        max_size 2MB
    }

    # Route LMS API calls to LMS. MFE React apps call these as relative URLs
    # (resolved against the apps.* origin). The ingress sends ALL MFE traffic
    # to this Caddy instance because ingress-nginx (hostNetwork) cannot reach
    # LMS pods on the control-plane node via pod CIDR. Caddy (on pod network)
    # can reach LMS via K8s service DNS.
    handle /api/* {
        reverse_proxy lms:8000 {
            header_up Host {http.request.host}
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle /login_refresh* {
        reverse_proxy lms:8000 {
            header_up Host {http.request.host}
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle /csrf/* {
        reverse_proxy lms:8000 {
            header_up Host {http.request.host}
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle /oauth2/* {
        reverse_proxy lms:8000 {
            header_up Host {http.request.host}
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    handle /login {
        reverse_proxy lms:8000 {
            header_up Host {http.request.host}
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Forwarded-Host {http.request.host}
        }
    }

    import proxy "mfe:8002"
}
