# Credentials Service
# CREDENTIALS_HOST is injected by the overlay (e.g. credentials.academyv2.mereka.io).
http://{$CREDENTIALS_HOST} {
    # Authn assets are served by MFE; keep service-domain admin/login pages branded/functional.
    handle /authn/* {
        reverse_proxy mfe:8002 {
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up traceparent {http.request.header.traceparent}
        }
    }

    # Keep service-domain admin login route aligned to the shared authn shell.
    handle /admin/login {
        rewrite * /authn/login
        reverse_proxy mfe:8002 {
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up traceparent {http.request.header.traceparent}
        }
    }
    handle /admin/login/* {
        rewrite * /authn/login
        reverse_proxy mfe:8002 {
            header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Request-ID {http.request.header.X-Request-ID}
            header_up traceparent {http.request.header.traceparent}
        }
    }

    @credentials_root path /
    header @credentials_root Content-Type "text/html; charset=utf-8"
    respond @credentials_root "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Credentials</title></head><body style='margin:0;padding:40px;background:#f5f7fb;color:#1a1623;font-family:Poppins,Lato,sans-serif'><main style='max-width:760px;margin:0 auto;background:#fff;padding:32px;border-radius:20px;border:1px solid rgba(26,22,35,.08);box-shadow:0 16px 50px rgba(26,22,35,.1)'><h1 style='margin:0 0 12px;color:#2d898b;font-size:2rem;line-height:1.2'>Credentials Service</h1><p style='margin:0 0 16px;font-size:1rem;line-height:1.6'>Credential issuance APIs are online. Use the admin route for operator actions and the health route for service checks.</p><p style='margin:0'><a href='/admin/login/' style='color:#295cad;font-weight:600;text-decoration:none'>Open admin login</a><span style='opacity:.5'> · </span><a href='/health/' style='color:#295cad;font-weight:600;text-decoration:none'>Health endpoint</a></p></main></body></html>" 200
    import proxy "credentials:8000"
}

# Forum v2 (Python) is now integrated into LMS - no standalone forum service.
