# Global configuration
{



}

# proxy directive snippet (with logging) to be used as follows:
#
#     import proxy "containername:port"
(proxy) {
    log {
        output stdout
        format filter {
            wrap json
            fields {
                common_log delete
                request>headers delete
                resp_headers delete
                tls delete
            }
        }
    }

    # This will compress requests that matches the default criteria set by Caddy.
    # see https://caddyserver.com/docs/caddyfile/directives/encode
    # for information about the defaults; i.e. how/when this will be applied.
    encode gzip

    reverse_proxy {args.0} {
        header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
        header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
    }


}

# LMS - localhost and production domains
# - localhost: local development
# - staging.academy.mereka.io: main staging environment
# - skillourfuture.staging.academy.mereka.io: MCT/Skill Our Future staging
# - academy.biji-biji.com: Biji-Biji Academy production
localhost{$default_site_port}, preview.localhost{$default_site_port}, staging.academy.mereka.io{$default_site_port}, skillourfuture.staging.academy.mereka.io{$default_site_port}, academy.biji-biji.com{$default_site_port} {
    @favicon_matcher {
        path_regexp ^/favicon.ico$
    }
    rewrite @favicon_matcher /theming/asset/images/favicon.ico

    # Limit profile image upload size
    handle_path /api/profile_images/*/*/upload {
        request_body {
            max_size 1MB
        }
    }

    import proxy "lms:8000"



    handle_path /* {
        request_body {
            max_size 4MB
        }
    }
}

# Studio/CMS - shared across all LMS sites per environment
# - studio.localhost: local development (serves all local LMS sites)
# - studio.staging.academy.mereka.io: staging Studio (serves staging + skillourfuture)
# - studio.academy.biji-biji.com: production Studio
studio.localhost{$default_site_port}, studio.staging.academy.mereka.io{$default_site_port}, studio.academy.biji-biji.com{$default_site_port} {
    @favicon_matcher {
        path_regexp ^/favicon.ico$
    }
    rewrite @favicon_matcher /theming/asset/images/favicon.ico

    import proxy "cms:8000"



    handle_path /* {
        request_body {
            max_size 250MB
        }
    }
}

# Discovery Service (Course Catalog API)
discovery.localhost{$default_site_port}, discovery.staging.academy.mereka.io{$default_site_port} {
    request_body {
        max_size 10MB
    }

    import proxy "discovery:8000"
}
# E-commerce Service
ecommerce.localhost{$default_site_port}, ecommerce.staging.academy.mereka.io{$default_site_port} {
    request_body {
        max_size 10MB
    }
    import proxy "ecommerce:8000"
}
# MFE (Micro-Frontends) - localhost and production
# - apps.localhost: local development
# - apps.staging.academy.mereka.io: main staging MFEs
# - apps.academy.biji-biji.com: Biji-Biji Academy production MFEs
apps.localhost{$default_site_port}, apps.staging.academy.mereka.io{$default_site_port}, apps.academy.biji-biji.com{$default_site_port} {
    request_body {
        max_size 2MB
    }
    import proxy "mfe:8002"
}
# Notes API
notes.localhost{$default_site_port}, notes.staging.academy.mereka.io{$default_site_port} {
    import proxy "notes:8000"
}

# Credentials Service (Certificate issuance)
credentials.staging.academy.mereka.io{$default_site_port} {
    import proxy "credentials:8000"
}

# Xqueue (external graders, local only)
xqueue.localhost{$default_site_port} {
    import proxy "xqueue:8000"
}
