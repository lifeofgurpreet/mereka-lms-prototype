(mfe_security_headers) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "DENY"
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' https:; font-src 'self' data: https://fonts.gstatic.com; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self';"
	header Referrer-Policy "strict-origin-when-cross-origin"
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
}

:8002 {
	import mfe_security_headers

	log {
		output stdout
		format filter {
			wrap json
			fields {
				common_log delete
				request>headers delete
				resp_headers delete
				tls delete
			}
		}
	}

	# Default: all responses must revalidate. This covers SPA routes served via try_files
	# (e.g. /authn/login → index.html) where the request path never matches *.html.
	header Cache-Control "no-cache"

	# Hashed static assets (webpack fingerprinted): safe to cache forever.
	# Overrides the default no-cache set above.
	@hashed {
		path *.js *.css *.woff *.woff2 *.ttf *.map *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# API proxy routes: never cache dynamic responses.
	# Overrides the default no-cache set above.
	@api_proxy {
		path /api/mfe_config/v1* /login_refresh* /orders* /payment*
	}
	header @api_proxy Cache-Control "no-store"

	# Route theme CSS requested at root path by MFE runtime injection to the matching
	# mounted MFE directory. Each application serves its own hashed theme assets under
	# /openedx/dist/<mfe-name>, but the generated PARAGON_THEME filenames are
	# relative. Without this mapping, root requests resolve to empty responses.
	@mfe_theme_css {
		path_regexp theme_css ^/(?:brand|paragon)-theme-[^/]+\.css$
	}
	handle @mfe_theme_css {
		root * /openedx/dist
		try_files /account{path} /authn{path} /communications{path} /course-authoring{path} /discussions{path} /gradebook{path} /learner-dashboard{path} /learner-record{path} /learning{path} /ora-grading{path} /profile{path} /u{path}
		file_server
	}

	# Runtime PARAGON theme assets are now emitted to /theme/*.min.css in MFE image.
	@mfe_theme_assets {
		path /theme/*
	}
	handle @mfe_theme_assets {
		root * /openedx/dist
		# Theme bundles are emitted per-MFE under /openedx/dist/<mfe>/theme/*.min.css.
		# Runtime minified bundles are copied to /openedx/dist/theme/*.min.css.
		# Check /theme first, then fall back to per-MFE paths for compatibility.
		try_files /theme{path} /account{path} /authn{path} /communications{path} /course-authoring{path} /discussions{path} /gradebook{path} /learner-dashboard{path} /learner-record{path} /learning{path} /ora-grading{path} /profile{path} /u{path}
		header Content-Type "text/css; charset=utf-8"
		header Cache-Control "public, max-age=300"
		file_server
	}

	# Profile API calls from the Profile MFE route through LMS domain routing.
	@mfe_profile_api {
		path /profile/api/*
	}
	reverse_proxy @mfe_profile_api lms:8000 {
		header_up Host {http.request.host}
	}

	reverse_proxy /api/mfe_config/v1* lms:8000 {
		# Preserve the original Host so LMS can resolve the correct SiteConfiguration
		# (required for multisite MFE config).
		header_up Host {http.request.host}
	}

	# MFEs use this endpoint to refresh the JWT cookie. Some frontends do not send cross-origin
	# cookies by default, so we expose /login_refresh on the MFE origin and reverse-proxy to LMS.
	reverse_proxy /login_refresh* lms:8000 {
		header_up Host {http.request.host}
	}

	# Account MFE does not implement /settings as a standalone SPA route.
	# Redirect it to the canonical account root so users don't hit a "page unavailable" screen.
	@account_settings_compat {
		path /account/settings /account/settings/
	}
	redir @account_settings_compat /account/ 302

	@mfe_authn {
		path /authn /authn/*
	}
	handle @mfe_authn {
		uri strip_prefix /authn
		root * /openedx/dist/authn
		try_files /{path} /index.html
		file_server
	}

	@mfe_account {
		path /account /account/*
	}
	handle @mfe_account {
		uri strip_prefix /account
		root * /openedx/dist/account
		try_files /{path} /index.html
		file_server
	}

	@mfe_communications {
		path /communications /communications/*
	}
	handle @mfe_communications {
		uri strip_prefix /communications
		root * /openedx/dist/communications
		try_files /{path} /index.html
		file_server
	}

	# Course Authoring MFE: build output is "course-authoring" in the MFE image.
	# Both /authoring/ and /course-authoring/ paths must work (mereka-lms-18ik).
	@mfe_course-authoring {
		path /course-authoring /course-authoring/*
	}
	handle @mfe_course-authoring {
		uri strip_prefix /course-authoring
		root * /openedx/dist/course-authoring
		try_files /{path} /index.html
		file_server
	}

	@mfe_authoring {
		path /authoring /authoring/*
	}
	handle @mfe_authoring {
		uri strip_prefix /authoring
		root * /openedx/dist/course-authoring
		try_files /{path} /index.html
		file_server
	}

	@mfe_discussions {
		path /discussions /discussions/*
	}
	handle @mfe_discussions {
		uri strip_prefix /discussions
		root * /openedx/dist/discussions
		try_files /{path} /index.html
		file_server
	}

	@mfe_gradebook {
		path /gradebook /gradebook/*
	}
	handle @mfe_gradebook {
		uri strip_prefix /gradebook
		root * /openedx/dist/gradebook
		try_files /{path} /index.html
		file_server
	}

	@mfe_learner-dashboard {
		path /learner-dashboard /learner-dashboard/*
	}
	handle @mfe_learner-dashboard {
		uri strip_prefix /learner-dashboard
		root * /openedx/dist/learner-dashboard
		try_files /{path} /index.html
		file_server
	}

	@mfe_learning {
		path /learning /learning/*
	}
	handle @mfe_learning {
		uri strip_prefix /learning
		root * /openedx/dist/learning
		try_files /{path} /index.html
		file_server
	}

	@mfe_learner-record {
		path /learner-record /learner-record/*
	}
	handle @mfe_learner-record {
		uri strip_prefix /learner-record
		root * /openedx/dist/learner-record
		try_files /{path} /index.html
		file_server
	}

	@mfe_ora-grading {
		path /ora-grading /ora-grading/*
	}
	handle @mfe_ora-grading {
		uri strip_prefix /ora-grading
		root * /openedx/dist/ora-grading
		try_files /{path} /index.html
		file_server
	}

	@mfe_profile {
		path /profile /profile/*
	}
	handle @mfe_profile {
		uri strip_prefix /profile
		root * /openedx/dist/profile
		try_files /{path} /index.html
		file_server
	}

	# Profile MFE routes are mounted at /u/:username (no /profile basename).
	# Serve the same profile SPA for /u/* while keeping /profile/* for its static assets.
	@mfe_profile_u {
		path /u /u/*
	}
	handle @mfe_profile_u {
		root * /openedx/dist/profile
		try_files /index.html
		file_server
	}

	# orders and payment MFEs are deprecated upstream (repos archived in openedx-unsupported).
	# Proxy to our custom payments-gateway service (PostgreSQL-backed, Stripe integration).
	reverse_proxy /orders* payments-gateway:8080 {
		header_up Host {http.request.host}
	}
	reverse_proxy /payment* payments-gateway:8080 {
		header_up Host {http.request.host}
	}

	# Stripe webhook endpoint — must be externally reachable for Stripe event delivery.
	# Stripe verifies webhook signatures server-side; no auth header needed here.
	reverse_proxy /webhooks/stripe* payments-gateway:8080 {
		header_up Host {http.request.host}
	}
}
