:8002 {
    log {
        output stdout
        format filter {
            wrap json
            fields {
                common_log delete
                request>headers delete
                resp_headers delete
                tls delete
            }
        }
    }

    

    reverse_proxy /api/mfe_config/v1* lms:8000 {
        # Preserve the original Host so LMS can resolve the correct SiteConfiguration
        # (required for multisite MFE config).
        header_up Host {http.request.host}
    }

    # MFEs use this endpoint to refresh the JWT cookie. Some frontends do not send cross-origin
    # cookies by default, so we expose /login_refresh on the MFE origin and reverse-proxy to LMS.
    reverse_proxy /login_refresh* lms:8000 {
        header_up Host {http.request.host}
    }

    # Account MFE does not implement /settings as a standalone SPA route.
    # Redirect it to the canonical account root so users don't hit a "page unavailable" screen.
    @account_settings_compat {
        path /account/settings /account/settings/
    }
    redir @account_settings_compat /account/ 302

    
    @mfe_authn {
        path /authn /authn/*
    }
    handle @mfe_authn {
        uri strip_prefix /authn
        root * /openedx/dist/authn
        try_files /{path} /index.html
        file_server
    }
    
    @mfe_account {
        path /account /account/*
    }
    handle @mfe_account {
        uri strip_prefix /account
        root * /openedx/dist/account
        try_files /{path} /index.html
        file_server
    }
    
    @mfe_communications {
        path /communications /communications/*
    }
    handle @mfe_communications {
        uri strip_prefix /communications
        root * /openedx/dist/communications
        try_files /{path} /index.html
        file_server
    }
    
    # Legacy /course-authoring/ compat: serve from authoring dist (mereka-lms-18ik)
    # The MFE build output is "authoring" but Tutor's default config uses "course-authoring".
    # Both paths must work; the SPA's JS assets use /authoring/ absolute paths.
    @mfe_course-authoring-compat {
        path /course-authoring /course-authoring/*
    }
    handle @mfe_course-authoring-compat {
        uri strip_prefix /course-authoring
        root * /openedx/dist/authoring
        try_files /{path} /index.html
        file_server
    }

    @mfe_authoring {
        path /authoring /authoring/*
    }
    handle @mfe_authoring {
        uri strip_prefix /authoring
        root * /openedx/dist/authoring
        try_files /{path} /index.html
