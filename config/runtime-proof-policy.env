# Canonical runtime proof policy for the current LMS operating model.
#
# This file is sourced by workflows and verification scripts. Keep values shell-safe.

# The authoritative browser/runtime proof lane for automated CI checks.
# Production is LIVE on rke2-prod (verified 2026-04-19: 30 deployments
# Running, https://academyv2.mereka.io serving Django 200). Automated CI
# targets staging only because CI runners do not yet have rke2-prod
# kubectl access; manual workflow_dispatch can target production.
AUTHORITATIVE_RUNTIME_PROOF_ENV=staging

# Automatic workflow_run post-deploy checks target the authoritative runtime
# proof lane (staging, per AUTHORITATIVE_RUNTIME_PROOF_ENV above). Production
# is LIVE on rke2-prod (verified 2026-04-19: 30 deployments Running under the
# mereka-lms namespace, https://academyv2.mereka.io serving Django 200), but
# the CI runner does not have rke2-prod kubectl access. The prior default
# of `production` routed to a prod-parked-state job that fails on the
# decommissioned gcp-gke-auth step (bead 64a3, evidence bundle
# docs/ops/evidence/gke-auth-workflow-classification-2026-04-19.md).
# Manual workflow_dispatch can still target production when an operator
# wants cross-cluster proof.
POST_DEPLOY_WORKFLOW_RUN_ENV=staging
POST_DEPLOY_MANUAL_DEFAULT_ENV=staging

STAGING_RUNTIME_BASE_URL=https://staging.academyv2.mereka.io
PROD_RUNTIME_BASE_URL=https://academyv2.mereka.io

# Production is LIVE on rke2-prod (30 deployments Running as of 2026-04-19,
# https://academyv2.mereka.io serving Django 200). Contradicts the earlier
# comment which said prod was parked — that was true during the GKE-era but
# is no longer true after the rke2-prod cutover. See evidence bundle
# docs/ops/evidence/gke-auth-workflow-classification-2026-04-19.md.
#
# PROD_PARKED_STATUS_CONTEXT + PROD_PARKED_VERIFIER retained as legacy
# references only — not invoked by live workflows (week-review item #3
# from 2026-04-20 will repoint/retire .github/workflows/post-deploy-e2e.yml
# which still has parked-state paths).
PROD_RUNTIME_MODE=live
# Legacy — not invoked by current post-deploy workflow (see comment above):
PROD_PARKED_STATUS_CONTEXT=prod-parked-state/auth
PROD_PARKED_VERIFIER=scripts/qa/verify-prod-parked-state.sh
PROD_FULL_RUNTIME_PROOF_VERIFIER=scripts/tenants/verify-prod-runtime-proof.sh
STAGING_RUNTIME_FIXTURE_MANIFEST=config/runtime-proof/staging.synthetic-proof-fixtures.yaml
PROD_RUNTIME_FIXTURE_MANIFEST=config/runtime-proof/prod.synthetic-proof-fixtures.yaml
SMOKE_ACCOUNT_REGISTRY_CONTRACT=config/smoke-account-registry.yaml
