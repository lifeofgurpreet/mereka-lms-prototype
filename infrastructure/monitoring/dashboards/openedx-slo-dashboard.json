        "height": 4,
        "widget": {
          "title": "LMS Error Rate (5xx/total)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"prometheus.googleapis.com/http_requests_total/counter\" resource.type=\"prometheus_target\" metric.label.\"service\"=\"lms\" metric.label.\"status\"=monitoring.regex.full_match(\"5..\") ",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  },
                  "unitOverride": "1"
                },
                "plotType": "LINE",
                "targetAxis": "Y1"
              }
            ],
            "thresholds": [
              {
                "value": 0.001,
                "targetAxis": "Y1",
                "label": "Warning (0.1%)"
              },
              {
                "value": 0.01,
                "targetAxis": "Y1",
                "label": "Critical (1.0%)"
              }
            ],
            "yAxis": {
              "label": "Error Rate (ratio)",
              "scale": "LINEAR"
            }
          }
        },
