  "displayName": "Open edX SLO Dashboard - Service Level Objectives",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "width": 12,
        "height": 2,
        "widget": {
          "title": "Dashboard Overview",
          "text": {
            "content": "**Open edX Service Level Objectives Dashboard**\n\nThis dashboard displays Tier 1 SLO metrics for LMS and CMS services, error budget status, and ownership information. All metrics are calculated over a 30-day rolling window.\n\n**Service Ownership:** Engineering Team | **Escalation:** engineering-lead \u2192 VP/CTO\n\n**Alert Rules:** [PrometheusRules](/monitoring/prometheusrule-slo.yaml) | **Runbook:** [SLO Playbook](/docs/operations/ONCALL_OBSERVABILITY_PLAYBOOK.md)",
            "format": "MARKDOWN"
          }
        },
        "xPos": 0,
        "yPos": 0
      },
      {
        "width": 6,
        "height": 4,
        "widget": {
          "title": "LMS Availability (30-day SLI)",
          "scorecard": {
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "filter": "metric.type=\"prometheus.googleapis.com/mereka_slo_availability_ratio/gauge\" resource.type=\"prometheus_target\" metric.label.\"service\"=\"lms\"",
                "aggregation": {
                  "alignmentPeriod": "300s",
                  "perSeriesAligner": "ALIGN_MEAN"
                }
              }
            },
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "thresholds": [
              {
                "value": 0.999,
                "color": "RED",
                "direction": "BELOW"
              },
              {
                "value": 0.9995,
                "color": "YELLOW",
                "direction": "BELOW"
              }
            ]
          }
        },
        "xPos": 0,
        "yPos": 2
      },
