{
  "displayName": "Mereka LMS - Redis",
  "gridLayout": {
    "columns": 2,
    "widgets": [
      {
        "title": "Memory used",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"redis.googleapis.com/stats/memory/used_bytes\" resource.type=\"redis_instance\" resource.label.\"instance_id\"=\"mereka-lms-redis\"",
                  "aggregation": {
                    "alignmentPeriod": "300s",
                    "perSeriesAligner": "ALIGN_MEAN"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Command ops/sec",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"redis.googleapis.com/stats/commands/ops\" resource.type=\"redis_instance\" resource.label.\"instance_id\"=\"mereka-lms-redis\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Network bytes/sec",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"redis.googleapis.com/stats/network/bytes\" resource.type=\"redis_instance\" resource.label.\"instance_id\"=\"mereka-lms-redis\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE"
                  }
                }
              }
            }
          ]
        }
      }
    ]
  }
}
