    {
      "id": 7,
      "type": "timeseries",
      "title": "Auth Failure Rate",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (namespace) (rate({namespace=~\"mereka-lms-dev|stg-mereka-lms\", container=\"lms\"} |~ \"(?i)(login_session|authentication|login_failed)\" |~ \"(HTTP/1\\.1 401|HTTP/1\\.1 403|HTTP/1\\.1 500|\\\"status\\\":4[0-9]{2}|\\\"status_code\\\":4[0-9]{2}|\\\"status\\\":500|\\\"status_code\\\":500)\" [$__interval]))",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    },
