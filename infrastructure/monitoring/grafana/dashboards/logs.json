    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP 5xx by Environment",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "sum by (namespace) (count_over_time({namespace=~\"mereka-lms-dev|stg-mereka-lms\"} |~ \"(HTTP/1\\\\.1 5[0-9]{2}|\\\"status\\\":5[0-9]{2}|\\\"status_code\\\":5[0-9]{2})\" [$__interval]))",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    },
    {
