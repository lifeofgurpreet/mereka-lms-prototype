    {
      "id": 10,
      "type": "timeseries",
      "title": "Top Pods by Error Volume",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "topk(8, sum by (namespace, pod) (count_over_time({namespace=~\"mereka-lms-dev|stg-mereka-lms\"} |~ \"(?i)(error|exception|panic|OperationalError|ConnectionError|RedisError|ENOSPC|Read-only file system)\" [$__interval])))",
          "legendFormat": "{{namespace}} / {{pod}}",
          "refId": "A"
        }
      ]
    },
