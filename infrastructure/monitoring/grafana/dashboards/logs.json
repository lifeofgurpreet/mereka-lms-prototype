          "expr": "sum(count_over_time({namespace=~\"mereka-lms-dev|stg-mereka-lms\"} |~ \"(?i)(login_session|authentication|login_failed)\" |~ \"(HTTP/1\\\\.1 401|HTTP/1\\\\.1 403|HTTP/1\\\\.1 500|\\\"status\\\":4[0-9]{2}|\\\"status_code\\\":4[0-9]{2}|\\\"status\\\":500|\\\"status_code\\\":500)\" [$__interval]))",
