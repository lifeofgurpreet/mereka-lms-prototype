        {
          "expr": "sum(count_over_time({namespace=~\"mereka-lms-dev|stg-mereka-lms\"} |~ \"(Can\\\\'t connect to MySQL|MySQL server has gone away|Lost connection to MySQL server|OperationalError)\" [$__interval]))",
