        {
          "expr": "sum(count_over_time({namespace=~\"mereka-lms-dev|stg-mereka-lms\"} |~ \"(redis\\\\.exceptions|Error 111 connecting to redis|ConnectionError|Timeout connecting to server|RedisError)\" [$__interval]))",
