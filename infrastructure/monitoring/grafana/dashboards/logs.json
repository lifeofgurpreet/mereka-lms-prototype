      "targets": [
        {
          "expr": "count(count_over_time({namespace=~\"mereka-lms-dev|stg-mereka-lms\"} |~ \"(?i)(error|exception|panic|OperationalError|ConnectionError|RedisError|ENOSPC)\" [5m]))",
          "refId": "A"
