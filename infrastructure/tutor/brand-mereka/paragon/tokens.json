{
  "_comment": "Placeholder tokens for OEP-48 migration. Maintains legacy keys while adding DTCG-compatible groups.",
  "$schema": "https://design-tokens.github.io/community-group/format/schema.json",
  "colors": {
    "primary": "#ab3b78",
    "secondary": "#237072",
    "success": "#2c6e49",
    "info": "#295cad",
    "warning": "#f4be48",
    "danger": "#8c002f"
  },
  "typography": {
    "font-family-sans-serif": "'Poppins', 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "font-family-heading": "'Lato', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
  },
  "color": {
    "primary": {
      "$value": "#ab3b78",
      "$type": "color"
    },
    "secondary": {
      "$value": "#237072",
      "$type": "color"
    },
    "success": {
      "$value": "#2c6e49",
      "$type": "color"
    },
    "info": {
      "$value": "#295cad",
      "$type": "color"
    },
    "warning": {
      "$value": "#f4be48",
      "$type": "color"
    },
    "danger": {
      "$value": "#8c002f",
      "$type": "color"
    }
  },
  "fontFamily": {
    "sansSerif": {
      "$value": "'Poppins', 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "$type": "fontFamily"
    },
    "heading": {
      "$value": "'Lato', 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "$type": "fontFamily"
    }
  }
}
