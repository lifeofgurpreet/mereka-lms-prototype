{
  "$schema": "https://design-tokens.github.io/community-group/format/schema.json",
  "$description": "Biji-Biji Initiative brand tokens — DTCG format. Minimal, bold black-and-gray palette with Raleway typography.",
  "color": {
    "primary": { "$value": "#000000", "$type": "color", "$description": "Biji-Biji black — primary CTA" },
    "secondary": { "$value": "#4b5563", "$type": "color", "$description": "Cool gray — secondary actions" },
    "success": { "$value": "#2c6e49", "$type": "color", "$description": "Success states" },
    "info": { "$value": "#374151", "$type": "color", "$description": "Informational — dark gray" },
    "warning": { "$value": "#9e7000", "$type": "color", "$description": "Warning states" },
    "danger": { "$value": "#8c002f", "$type": "color", "$description": "Error/danger — burgundy" }
  },
  "fontFamily": {
    "sans-serif": { "$value": "'Raleway', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" },
    "heading": { "$value": "'Raleway', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" }
  }
}
