{
  "$schema": "https://design-tokens.github.io/community-group/format/schema.json",
  "$description": "Skill Our Future tenant brand tokens — DTCG format. Site-derived purple, teal, gold, and UNDP blue palette with Poppins typography.",
  "color": {
    "primary": { "$value": "#450B7F", "$type": "color", "$description": "SOF purple — primary CTA and wordmark" },
    "secondary": { "$value": "#82C3C7", "$type": "color", "$description": "SOF teal — secondary actions and highlights" },
    "success": { "$value": "#237072", "$type": "color", "$description": "Positive states" },
    "info": { "$value": "#0063AC", "$type": "color", "$description": "UNDP blue — informational accents and links" },
    "warning": { "$value": "#F7CD56", "$type": "color", "$description": "SOF gold — warnings and highlights" },
    "danger": { "$value": "#7B2A5A", "$type": "color", "$description": "Deep plum — destructive/error states" }
  },
  "fontFamily": {
    "sans-serif": { "$value": "'Poppins', 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" },
    "heading": { "$value": "'Poppins', 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" }
  }
}
