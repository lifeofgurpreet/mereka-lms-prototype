{
  "$schema": "https://design-tokens.github.io/community-group/format/schema.json",
  "$description": "SkillOurFuture Academy brand tokens — DTCG format. Navy-and-gold palette with Nunito typography.",
  "color": {
    "primary": { "$value": "#1a3c6e", "$type": "color", "$description": "Navy blue — primary CTA" },
    "secondary": { "$value": "#f5a623", "$type": "color", "$description": "Gold — secondary actions / accent" },
    "success": { "$value": "#2c6e49", "$type": "color", "$description": "Success states" },
    "info": { "$value": "#295cad", "$type": "color", "$description": "Informational — lighter blue" },
    "warning": { "$value": "#f5a623", "$type": "color", "$description": "Warning states (same as secondary)" },
    "danger": { "$value": "#e8460e", "$type": "color", "$description": "Error/danger — orange-red" }
  },
  "fontFamily": {
    "sans-serif": { "$value": "'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" },
    "heading": { "$value": "'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" }
  }
}
