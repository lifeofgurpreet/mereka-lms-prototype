{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "lane",
    "environment",
    "tenant_filter",
    "mode",
    "verdict",
    "verdict_planes",
    "contract",
    "release_truth",
    "artifacts",
    "matrix",
    "checks"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "runtime-routing-proof/v1" },
    "generated_at_utc": { "type": "string", "minLength": 1 },
    "lane": { "type": "string", "const": "runtime-routing" },
    "environment": { "type": "string", "minLength": 1 },
    "tenant_filter": { "type": ["string", "null"] },
    "mode": { "type": "string", "enum": ["dry-run", "execute"] },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failed_checks"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "failed_checks": { "type": "integer", "minimum": 0 }
      }
    },
    "verdict_planes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routing_core", "adjacent_surface"],
      "properties": {
        "routing_core": { "$ref": "#/$defs/verdictPlane" },
        "adjacent_surface": { "$ref": "#/$defs/verdictPlane" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_path", "source", "source_version", "schema_version"],
      "properties": {
        "matrix_path": { "type": "string", "minLength": 1 },
        "source": { "type": ["string", "null"] },
        "source_version": { "type": ["string", "null"] },
        "schema_version": { "type": ["string", "null"] }
      }
    },
    "release_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_object_id",
        "release_object_json",
        "build_origin_environment",
        "promotion_target_environment"
      ],
      "properties": {
        "release_object_id": { "type": ["string", "null"] },
        "release_object_json": { "type": ["string", "null"] },
        "build_origin_environment": { "type": ["string", "null"] },
        "promotion_target_environment": { "type": ["string", "null"] }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_dir",
        "matrix",
        "checks_tsv",
        "summary_json",
        "truth_ledger_json",
        "canonical_truth_ledger_json",
        "release_object_json"
      ],
      "properties": {
        "output_dir": { "type": "string", "minLength": 1 },
        "matrix": { "type": "string", "minLength": 1 },
        "checks_tsv": { "type": "string", "minLength": 1 },
        "summary_json": { "type": "string", "minLength": 1 },
        "truth_ledger_json": { "type": "string", "minLength": 1 },
        "canonical_truth_ledger_json": { "type": "string", "minLength": 1 },
        "release_object_json": { "type": ["string", "null"] }
      }
    },
    "matrix": { "type": "object" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "exit_code", "log"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer", "minimum": 0 },
          "log": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "verdictPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failed_checks", "check_count"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail", "not-applicable"] },
        "failed_checks": { "type": "integer", "minimum": 0 },
        "check_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
