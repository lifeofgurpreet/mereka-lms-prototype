{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "lane",
    "environment",
    "record_id",
    "contract_truth",
    "repo_truth",
    "release_truth",
    "infra_truth",
    "argo_truth",
    "runtime_truth",
    "acceptance_truth",
    "plane_comparisons",
    "final_verdict",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "runtime-truth-ledger/v1" },
    "generated_at_utc": { "type": "string", "minLength": 1 },
    "lane": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "tenant_filter": { "type": ["string", "null"] },
    "record_id": { "type": "string", "minLength": 1 },
    "contract_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_version", "schema_version", "matrix_sha256"],
      "properties": {
        "source": { "type": ["string", "null"] },
        "source_version": { "type": ["string", "null"] },
        "schema_version": { "type": ["string", "null"] },
        "matrix_sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
      }
    },
    "repo_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_commit_sha", "acceptance_command", "acceptance_mode", "acceptance_summary_json"],
      "properties": {
        "app_commit_sha": { "type": ["string", "null"] },
        "acceptance_command": { "type": "string", "minLength": 1 },
        "acceptance_mode": { "type": ["string", "null"] },
        "acceptance_summary_json": { "type": "string", "minLength": 1 }
      }
    },
    "release_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_object_id", "openedx_image", "mfe_image"],
      "properties": {
        "release_object_id": { "type": ["string", "null"] },
        "release_object_json": { "type": ["string", "null"] },
        "build_origin_environment": { "type": ["string", "null"] },
        "promotion_target_environment": { "type": ["string", "null"] },
        "openedx_image": { "$ref": "#/$defs/imageRefOrNull" },
        "mfe_image": { "$ref": "#/$defs/imageRefOrNull" },
        "proof_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "infra_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "infra_commit_sha"],
      "properties": {
        "status": { "type": "string", "enum": ["known", "unknown"] },
        "infra_commit_sha": { "type": ["string", "null"] }
      }
    },
    "argo_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "app_name"],
      "properties": {
        "status": { "type": "string", "enum": ["known", "unknown"] },
        "app_name": { "type": ["string", "null"] },
        "sync_status": { "type": ["string", "null"] },
        "health_status": { "type": ["string", "null"] },
        "revision": { "type": ["string", "null"] },
        "reconciled_at": { "type": ["string", "null"] }
      }
    },
    "runtime_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "namespace", "deployments"],
      "properties": {
        "status": { "type": "string", "enum": ["known", "unknown"] },
        "namespace": { "type": ["string", "null"] },
        "deployments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "ready_replicas", "replicas", "images"],
            "properties": {
              "name": { "type": ["string", "null"] },
              "ready_replicas": { "type": "integer", "minimum": 0 },
              "replicas": { "type": "integer", "minimum": 0 },
              "images": {
                "type": "array",
                "items": { "$ref": "#/$defs/imageRef" }
              }
            }
          }
        },
        "tracked_images": {
          "type": "array",
          "items": { "$ref": "#/$defs/imageRef" }
        }
      }
    },
    "acceptance_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_path", "summary_json", "verdict", "verdict_planes", "check_statuses"],
      "properties": {
        "bundle_path": { "type": ["string", "null"] },
        "summary_json": { "type": "string", "minLength": 1 },
        "verdict": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "failed_checks"],
          "properties": {
            "status": { "type": "string", "enum": ["pass", "fail"] },
            "failed_checks": { "type": "integer", "minimum": 0 }
          }
        },
        "verdict_planes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["routing_core", "adjacent_surface"],
          "properties": {
            "routing_core": { "$ref": "#/$defs/verdictPlane" },
            "adjacent_surface": { "$ref": "#/$defs/verdictPlane" }
          }
        },
        "check_statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "exit_code", "log"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "exit_code": { "type": "integer", "minimum": 0 },
              "log": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "plane_comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plane", "status", "reason"],
        "properties": {
          "plane": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pass", "fail", "unknown"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "final_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail", "partial"] },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth_ledger_json", "acceptance_bundle", "acceptance_summary_json"],
      "properties": {
        "truth_ledger_json": { "type": "string", "minLength": 1 },
        "release_object_json": { "type": ["string", "null"] },
        "acceptance_bundle": { "type": ["string", "null"] },
        "acceptance_summary_json": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "imageRefOrNull": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/imageRef" }
      ]
    },
    "imageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "repository", "tag", "digest"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": ["string", "null"] },
        "digest": { "type": ["string", "null"] }
      }
    },
    "verdictPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failed_checks", "check_count"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail", "not-applicable"] },
        "failed_checks": { "type": "integer", "minimum": 0 },
        "check_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
