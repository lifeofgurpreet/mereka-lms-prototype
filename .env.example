# Mereka LMS Environment Configuration
# DO NOT commit this file with real values!
# Copy to .env and fill in the values

# ============================================================================
# TUTOR CONFIGURATION
# ============================================================================
TUTOR_ROOT=C:/Users/MSAdmin/mereka-lms/tutor_env

# ============================================================================
# LOCAL DEVELOPMENT HOSTS
# ============================================================================
LMS_HOST=localhost
CMS_HOST=studio.localhost
MFE_HOST=apps.localhost

# ============================================================================
# LOCAL DATABASE CONFIGURATION (Docker Containers)
# ============================================================================
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MYSQL_HOST=mysql
MYSQL_PORT=3306
REDIS_HOST=redis
REDIS_PORT=6379
RUN_MONGODB=true

# ============================================================================
# MONGODB ATLAS (CLOUD - For Staging/Production Forum)
# ============================================================================
# Source of truth: Infisical `/k8s/mereka-lms` (synced to GCP Secret Manager + K8s via ESO)
# Do NOT put real URIs/passwords in this repo.
MONGODB_ATLAS_URI=mongodb+srv://cs_comments_user:<password>@cluster-mereka-lms.2pjex4s.mongodb.net/cs_comments_service?retryWrites=true&w=majority
MONGODB_ATLAS_CLUSTER=cluster-mereka-lms
MONGODB_ATLAS_VERSION=8.0.16
MONGODB_ATLAS_REGION=ap-southeast-1
MONGODB_ATLAS_TIER=M10

# ============================================================================
# AWS SES (Email Service)
# ============================================================================
# Source of truth: Infisical (synced to GCP Secret Manager + K8s)
EMAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=<ses-smtp-username>
EMAIL_HOST_PASSWORD=<ses-smtp-password>
DEFAULT_FROM_EMAIL=learn@mereka.my
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SES Status
AWS_SES_REGION=ap-southeast-1
AWS_SES_QUOTA_DAILY=200000
AWS_SES_QUOTA_PER_SECOND=100
AWS_SES_PRODUCTION_MODE=true

# ============================================================================
# GCP CONFIGURATION
# ============================================================================
GCP_PROJECT_ID=mereka-lms
GCP_REGION=asia-southeast1
GCP_ACCOUNT=gurpreet@biji-biji.com

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================
DOCKER_MEMORY_GB=15.23
DOCKER_VERSION=28.5.2

# ============================================================================
# PYTHON CONFIGURATION
# ============================================================================
PYTHON_VERSION=3.12.10

# ============================================================================
# OPEN EDX / TUTOR VERSIONS
# ============================================================================
TUTOR_VERSION=21.0.0
MFE_PLUGIN_VERSION=21.0.0
OPENEDX_VERSION=ulmo.1
OPENEDX_RELEASE=open-release/ulmo.master

# ============================================================================
# TUTOR PLUGINS
# ============================================================================
TUTOR_PLUGINS=mfe,discovery,notes,ecommerce,xqueue,forum,indigo

# ============================================================================
# DOCKER IMAGES
# ============================================================================
OPENEDX_IMAGE=docker.io/overhangio/openedx:21.0.0-indigo
OPENEDX_IMAGE_SIZE=5.04GB
MFE_IMAGE=docker.io/overhangio/openedx-mfe:21.0.0-indigo

# ============================================================================
# GCP ARTIFACT REGISTRY (For Cloud Deployment)
# ============================================================================
GCR_REGISTRY=asia-southeast1-docker.pkg.dev
GCR_PROJECT=mereka-lms
GCR_REPO=openedx

# ============================================================================
# AWS IAM (Limited SES Access)
# ============================================================================
AWS_IAM_USER=ses-cli-user
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_DEFAULT_REGION=ap-southeast-1

# ============================================================================
# MONGODB ATLAS CLI
# ============================================================================
ATLAS_CLI_VERSION=1.50.1

# ============================================================================
# NETWORK ACCESS
# ============================================================================
# Current PC IP (whitelisted in MongoDB Atlas)
CURRENT_IP=45.83.126.9

