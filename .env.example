REDIS_PORT=6379
RUN_MONGODB=true

# ============================================================================
# MONGODB ATLAS (CLOUD - For Staging/Production Forum)
# ============================================================================
# GCP Secret: mongodb-atlas-uri (version 5)
MONGODB_ATLAS_URI=mongodb+srv://cs_comments_user:CR3ATIVITY@cluster-mereka-lms.2pjex4s.mongodb.net/cs_comments_service?retryWrites=true&w=majority
