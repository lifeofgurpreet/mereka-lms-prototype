# dev.env — Environment constants for the dev tenant toolkit
#
# Sourced by verify-dev-runtime-proof.sh and seed-dev-sites.sh.
# Do NOT set -euo pipefail here; callers own that.

# ── Cluster / namespace ───────────────────────────────────────────────────────
NAMESPACE="${NAMESPACE:-mereka-lms-dev}"
ENV_LABEL="dev"

# ── Output file prefix ────────────────────────────────────────────────────────
# Used as the stem for all proof artifact filenames.
PROOF_PREFIX="dev"

# ── Admin host (non-critical check) ──────────────────────────────────────────
ADMIN_HOST="admin.academyv2.mereka.dev"

# ── Primary tenant reference (for cross-contamination detection) ─────────────
# Dev is single-tenant, so cross-contamination is not checked at the same
# level as staging. These are provided for parity so the common library
# can use a uniform code path.
PRIMARY_LMS="academyv2.mereka.dev"
PRIMARY_MFE="apps.academyv2.mereka.dev"
PRIMARY_COOKIE_DOMAIN=".academyv2.mereka.dev"

# ── Tenant table ──────────────────────────────────────────────────────────────
# Format: "SLUG:LMS_HOST:STUDIO_HOST:MFE_HOST:EXPECTED_COOKIE_DOMAIN"
declare -a TENANTS=(
  "mereka:academyv2.mereka.dev:studio.academyv2.mereka.dev:apps.academyv2.mereka.dev:.academyv2.mereka.dev"
  "biji-biji:biji-biji.academyv2.mereka.dev:studio.biji-biji.academyv2.mereka.dev:apps.biji-biji.academyv2.mereka.dev:.biji-biji.academyv2.mereka.dev"
  "skillourfuture:skillourfuture.academyv2.mereka.dev:studio.skillourfuture.academyv2.mereka.dev:apps.skillourfuture.academyv2.mereka.dev:.skillourfuture.academyv2.mereka.dev"
)

# ── Seed tenant definitions ───────────────────────────────────────────────────
# Format: SLUG|DOMAIN|NAME|LMS_ROOT_URL|MFE_BASE_URL|COURSE_ORG_FILTER_JSON|THEME_NAME|PRIMARY_COLOR|SECONDARY_COLOR|ACCENT_COLOR
declare -a TENANT_DEFS=(
  'mereka|academyv2.mereka.dev|Mereka Academy (Dev)|https://academyv2.mereka.dev|https://apps.academyv2.mereka.dev|["MEREKA"]|mereka|#ab3b78|#237072|#295cad'
  'biji-biji|biji-biji.academyv2.mereka.dev|Biji-Biji Academy (Dev)|https://biji-biji.academyv2.mereka.dev|https://apps.biji-biji.academyv2.mereka.dev|["BIJIBIJI"]|mereka|#2d6a4f|#40916c|#52b788'
  'skillourfuture|skillourfuture.academyv2.mereka.dev|Skill Our Future (Dev)|https://skillourfuture.academyv2.mereka.dev|https://apps.skillourfuture.academyv2.mereka.dev|["SKILLOURFUTURE"]|mereka|#1a3c6e|#2563eb|#3b82f6'
)

# ── CMS URL resolver ──────────────────────────────────────────────────────────
# Returns the Studio URL for a given SLUG. Called by site-reconcile-common.sh.
_cms_url_for_slug() {
  local slug="$1"
  case "$slug" in
    mereka)         echo "https://studio.academyv2.mereka.dev" ;;
    biji-biji)      echo "https://studio.biji-biji.academyv2.mereka.dev" ;;
    skillourfuture) echo "https://studio.skillourfuture.academyv2.mereka.dev" ;;
    *)              echo "" ;;
  esac
}
