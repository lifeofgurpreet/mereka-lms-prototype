# dev.env — Environment constants for the dev tenant toolkit
#
# Sourced by verify-dev-runtime-proof.sh and seed-dev-sites.sh.
# Do NOT set -euo pipefail here; callers own that.

# ── Cluster / namespace ───────────────────────────────────────────────────────
NAMESPACE="${NAMESPACE:-mereka-lms-dev}"
ENV_LABEL="dev"

# ── Output file prefix ────────────────────────────────────────────────────────
# Used as the stem for all proof artifact filenames.
PROOF_PREFIX="dev"

# ── Admin host (non-critical check) ──────────────────────────────────────────
ADMIN_HOST="admin.academyv2.mereka.dev"

# ── Primary tenant reference (for cross-contamination detection) ─────────────
# Dev is single-tenant, so cross-contamination is not checked at the same
# level as staging. These are provided for parity so the common library
# can use a uniform code path.
PRIMARY_LMS="academyv2.mereka.dev"
PRIMARY_MFE="apps.academyv2.mereka.dev"
PRIMARY_COOKIE_DOMAIN=".academyv2.mereka.dev"

# ── Tenant table ──────────────────────────────────────────────────────────────
# Format: "SLUG:LMS_HOST:STUDIO_HOST:MFE_HOST:EXPECTED_COOKIE_DOMAIN"
declare -a TENANTS=(
  "mereka:academyv2.mereka.dev:studio.academyv2.mereka.dev:apps.academyv2.mereka.dev:.academyv2.mereka.dev"
)

# ── Seed tenant definitions ───────────────────────────────────────────────────
# Format: SLUG|DOMAIN|NAME|LMS_ROOT_URL|MFE_BASE_URL|COURSE_ORG_FILTER_JSON|THEME_NAME
declare -a TENANT_DEFS=(
  'mereka|academyv2.mereka.dev|Mereka Academy Dev|https://academyv2.mereka.dev|https://apps.academyv2.mereka.dev|["BBI","Mereka"]|mereka'
)

# ── CMS URL resolver ──────────────────────────────────────────────────────────
# Returns the Studio URL for a given SLUG. Called by site-reconcile-common.sh.
_cms_url_for_slug() {
  local slug="$1"
  case "$slug" in
    mereka) echo "https://studio.academyv2.mereka.dev" ;;
    *)      echo "" ;;
  esac
}
