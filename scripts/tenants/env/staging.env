# staging.env — Environment constants for the staging tenant toolkit
#
# Sourced by verify-staging-runtime-proof.sh and seed-staging-sites.sh.
# Do NOT set -euo pipefail here; callers own that.

# ── Cluster / namespace ───────────────────────────────────────────────────────
NAMESPACE="${NAMESPACE:-stg-mereka-lms}"
ENV_LABEL="staging"

# ── Output file prefix ────────────────────────────────────────────────────────
# Used as the stem for all proof artifact filenames.
PROOF_PREFIX="staging"

# ── Admin host (non-critical check) ──────────────────────────────────────────
ADMIN_HOST="staging.admin.academyv2.mereka.io"

# ── Primary tenant reference (for cross-contamination detection) ─────────────
PRIMARY_LMS="staging.academyv2.mereka.io"
PRIMARY_MFE="staging.apps.academyv2.mereka.io"
PRIMARY_COOKIE_DOMAIN=".staging.academyv2.mereka.io"

# ── Tenant table ──────────────────────────────────────────────────────────────
# Format: "SLUG:LMS_HOST:STUDIO_HOST:MFE_HOST:EXPECTED_COOKIE_DOMAIN"
# Derived from deploy/k8s/tenancy/tenant-registry.yaml (staging section).
declare -a TENANTS=(
  "mereka:staging.academyv2.mereka.io:staging.studio.academyv2.mereka.io:staging.apps.academyv2.mereka.io:.staging.academyv2.mereka.io"
  "biji-biji:staging.academy.biji-biji.com:staging.studio.academy.biji-biji.com:staging.apps.academy.biji-biji.com:.staging.academy.biji-biji.com"
  "skillourfuture:staging.skillourfuture.academy.mereka.io:staging.studio.skillourfuture.academy.mereka.io:staging.apps.skillourfuture.academy.mereka.io:.staging.skillourfuture.academy.mereka.io"
)

# ── Seed tenant definitions ───────────────────────────────────────────────────
# Format: SLUG|DOMAIN|NAME|LMS_ROOT_URL|MFE_BASE_URL|COURSE_ORG_FILTER_JSON|THEME_NAME
declare -a TENANT_DEFS=(
  'mereka|staging.academyv2.mereka.io|Mereka Academy|https://staging.academyv2.mereka.io|https://staging.apps.academyv2.mereka.io|["BBI","Mereka"]|mereka'
  'biji-biji|staging.academy.biji-biji.com|Biji-Biji Academy|https://staging.academy.biji-biji.com|https://staging.apps.academy.biji-biji.com|["BijiBiji"]|'
  'skillourfuture|staging.skillourfuture.academy.mereka.io|Skill Our Future|https://staging.skillourfuture.academy.mereka.io|https://staging.apps.skillourfuture.academy.mereka.io|["SoF"]|'
)

# ── CMS URL resolver ──────────────────────────────────────────────────────────
# Returns the Studio URL for a given SLUG. Called by site-reconcile-common.sh.
_cms_url_for_slug() {
  local slug="$1"
  case "$slug" in
    mereka)         echo "https://staging.studio.academyv2.mereka.io" ;;
    biji-biji)      echo "https://staging.studio.academy.biji-biji.com" ;;
    skillourfuture) echo "https://staging.studio.skillourfuture.academy.mereka.io" ;;
    *)              echo "" ;;
  esac
}
