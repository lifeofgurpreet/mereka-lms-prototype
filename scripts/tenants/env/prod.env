# prod.env — Environment constants for the production tenant toolkit
#
# Sourced by verify-prod-runtime-proof.sh when production runtime proof is
# explicitly activated. Do NOT set -euo pipefail here; callers own that.

# ── Cluster / namespace ───────────────────────────────────────────────────────
KUBE_CONTEXT="${KUBE_CONTEXT:-rke2-prod}"
NAMESPACE="${NAMESPACE:-mereka-lms}"
ENV_LABEL="production"

# ── Output file prefix ────────────────────────────────────────────────────────
PROOF_PREFIX="prod"

# ── Admin host (non-critical check) ──────────────────────────────────────────
ADMIN_HOST="admin.academyv2.mereka.io"

# ── Primary tenant reference (for cross-contamination detection) ─────────────
PRIMARY_LMS="academyv2.mereka.io"
PRIMARY_MFE="apps.academyv2.mereka.io"
PRIMARY_COOKIE_DOMAIN=".academyv2.mereka.io"

# ── Tenant table ──────────────────────────────────────────────────────────────
# Format: "SLUG:LMS_HOST:STUDIO_HOST:MFE_HOST:EXPECTED_COOKIE_DOMAIN"
# Derived from deploy/k8s/tenancy/tenant-registry.yaml (production section).
declare -a TENANTS=(
  "mereka:academyv2.mereka.io:studio.academyv2.mereka.io:apps.academyv2.mereka.io:.academyv2.mereka.io"
  "biji-biji:academy.biji-biji.com:studio.academy.biji-biji.com:apps.academy.biji-biji.com:.academy.biji-biji.com"
  "skillourfuture:skillourfuture.academy.mereka.io:studio.skillourfuture.academyv2.mereka.io:apps.skillourfuture.academyv2.mereka.io:.skillourfuture.academy.mereka.io"
)

# ── Seed tenant definitions ───────────────────────────────────────────────────
# Format: SLUG|DOMAIN|NAME|LMS_ROOT_URL|MFE_BASE_URL|COURSE_ORG_FILTER_JSON|THEME_NAME|PRIMARY_COLOR|SECONDARY_COLOR|ACCENT_COLOR
declare -a TENANT_DEFS=(
  'mereka|academyv2.mereka.io|Mereka Academy|https://academyv2.mereka.io|https://apps.academyv2.mereka.io|["MEREKA"]|mereka|#ab3b78|#237072|#295cad'
  'biji-biji|academy.biji-biji.com|Biji-Biji Academy|https://academy.biji-biji.com|https://apps.academy.biji-biji.com|["BIJIBIJI"]|mereka|#2d6a4f|#40916c|#52b788'
  'skillourfuture|skillourfuture.academy.mereka.io|Skill Our Future|https://skillourfuture.academy.mereka.io|https://apps.skillourfuture.academyv2.mereka.io|["SKILLOURFUTURE"]|mereka|#1a3c6e|#2563eb|#3b82f6'
)

# ── CMS URL resolver ──────────────────────────────────────────────────────────
_cms_url_for_slug() {
  local slug="$1"
  case "$slug" in
    mereka)         echo "https://studio.academyv2.mereka.io" ;;
    biji-biji)      echo "https://studio.academy.biji-biji.com" ;;
    skillourfuture) echo "https://studio.skillourfuture.academyv2.mereka.io" ;;
    *)              echo "" ;;
  esac
}
