# Mereka LMS SPA — environment variables
# Copy to `.env.local` and fill in real values. DO NOT commit `.env.local`.
#
# Obtaining these values:
#   1. Open edX backend URL (VITE_OPENEDX_BASE_URL):
#      Staging: request a tenant at staging-learn.mereka.org from Gurpreet
#      Production: https://academyv2.mereka.io (coordinate before pointing here)
#
#   2. OAuth2 credentials (VITE_OAUTH_CLIENT_ID):
#      Registered at {base_url}/admin/oauth2_provider/application/
#      Ask Gurpreet or Malasari. Requires:
#        - Client type: Public
#        - Authorization grant type: Authorization code
#        - PKCE required: true
#        - Redirect URI: {VITE_OAUTH_REDIRECT_URI}

VITE_OPENEDX_BASE_URL=https://staging-learn.mereka.org
VITE_OAUTH_CLIENT_ID=REPLACE_ME
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Dev-only flag — bypasses auth, renders pages with mock data.
# MUST be `false` in production.
VITE_USE_MOCK_DATA=true
