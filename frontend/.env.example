# ---------------------------------------------------------------------------
# Mereka LMS SPA — environment (phase-0/spa-foundation)
# Copy to .env.local and fill in any REPLACE_ME values.
# ---------------------------------------------------------------------------

# Open edX LMS base URL.
# - Public (unauthenticated) endpoints work immediately — no OAuth app needed.
# - Authenticated endpoints require either (a) the SPA to be served under
#   *.mereka.dev so it can reuse the existing MFE JWT cookies, or
#   (b) a registered OAuth2 client id on the LMS side (see docs/AUTH_STRATEGY.md).
VITE_OPENEDX_BASE_URL=https://academyv2.mereka.dev

# MFE (frontend-app-authn) origin used for redirect-based login.
# This is where the user is sent to sign in / register; on return, JWT cookies
# are set on .mereka.dev (only effective when our SPA is hosted there too).
VITE_OPENEDX_AUTHN_URL=https://apps.academyv2.mereka.dev

# Studio (authoring) origin — used for Studio redirects from the SPA.
VITE_OPENEDX_STUDIO_URL=https://studio.academyv2.mereka.dev

# OAuth client id. Leave blank to force cookie-based auth (reuse MFE JWT cookies).
# If/when Gurpreet registers a dedicated client for this SPA, drop it in here.
VITE_OAUTH_CLIENT_ID=

# Only used when VITE_OAUTH_CLIENT_ID is set (PKCE auth-code flow).
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# When true, API modules return local fixtures instead of hitting the network.
# Set to false once you want to see real academyv2 data.
VITE_USE_MOCK_DATA=false

# Feature flag: show an in-app notice when cookie auth isn't viable
# (SPA served from a non-*.mereka.dev host).
VITE_SHOW_CROSS_DOMAIN_AUTH_NOTICE=true
